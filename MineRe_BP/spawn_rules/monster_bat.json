{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "minere:monster_bat",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:spawns_underground": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": true
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 60
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 3
        },
        "minecraft:density_limit": {
          "surface": 5,
          "underground": 5
        },
        
        "minecraft:biome_filter": {
          "test": "has_biome_tag", "operator":"==", "value": "monster"
        }
      },
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 1,
          "adjust_for_weather": true
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 30
        },
        "minecraft:density_limit": {
          "surface": 5,
          "underground": 5
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 2
        },
        "minecraft:biome_filter": {
          "none_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "desert"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "ocean"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "frozen"
            }
          ],
          "all_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "monster"
            }
          ]
        }
      }
    ]
  }
}