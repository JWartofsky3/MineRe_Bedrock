{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "minere:goblin_cavalry_placeholder",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": "minecraft:grass",
        "minecraft:weight": {
          "default": 12
        },
        "minecraft:herd": {
          "min_size": 3,
          "max_size": 6
        },
        "minecraft:density_limit": {
          "surface": 8,
          "underground": 8
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:biome_filter": {
          "none_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "ocean"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "desert"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "frozen"
            }
          ],
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "monster"
            }
          ]
        }
      }
    ]
  }
}