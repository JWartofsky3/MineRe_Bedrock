{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:ice_dungeon_rule_frozen",
      "places_feature": "minere:ice_dungeon_feature"
    },
    "conditions": {
      "placement_pass": "after_underground_pass",
      "minecraft:biome_filter": {
        "any_of": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "frozen"
          }
        ],
        "none_of": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "ocean"
          },
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "river"
          },
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "beach"
          }
        ]
      }
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/200,v.originx/200); return (t.noise < -0.25) ? 1 : 0;",
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": {
        "extent": [0, "query.heightmap(variable.worldx, variable.worldz) - 8"],
        "distribution": "uniform"
      },
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "scatter_chance": {
        "numerator": 1,
        "denominator": 50
      }
    }
  }
}
