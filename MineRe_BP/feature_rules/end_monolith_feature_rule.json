{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:end_monolith_feature_rule",
      "places_feature": "minere:monolith_feature"
    },
    "conditions": {
      "placement_pass": "underground_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "the_end"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "(Math.abs(v.originz) < 1000 && Math.abs(v.originx) < 1000) ? 0 : 1",
      "x": {
        "distribution": "uniform",
        "extent": [-8, 8]
      },
      "y": {
        "distribution": "uniform",
        "extent": [64, 80]
      },
      "z": {
        "distribution": "uniform",
        "extent": [-8, 8]
      },
      "scatter_chance": {
        "numerator": 1,
        "denominator": 4000
      }
    }
  }
}
