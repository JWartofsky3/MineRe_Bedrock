{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:giant_beehive_feature_rule",
      "places_feature": "minere:giant_beehive_snap_to_ceiling_feature"
    },
    "conditions": {
      "placement_pass": "after_underground_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "lush_caves"
            }
          ]
        },
        {
          "none_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "dripstone_caves"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "deep_dark"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "frozen"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": 2,
      "x": 0,
      "y": {
        "extent": [0, "query.heightmap(variable.worldx, variable.worldz) - 8"],
        "distribution": "uniform"
      },
      "z": 0,
      "scatter_chance": {
        "numerator": 1,
        "denominator": 5
      }
    }
  }
}
