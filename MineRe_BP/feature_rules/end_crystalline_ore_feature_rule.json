{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:end_crystalline_ore_feature_rule",
      "places_feature": "minere:end_crystalline_ore_feature"
    },
    "conditions": {
      "placement_pass": "first_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "the_end"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/160,v.originx/160); return (Math.abs(v.originz) < 1000 && Math.abs(v.originx) < 1000) ? 0 : query.heightmap(v.originx, v.originz) < 10 ? 0 : (t.noise < -0.9) ? 3 : (t.noise < -0.8) ? 2 : 0;",
      "x": {
        "distribution": "uniform",
        "extent": [-16, 0]
      },
      "y": {
        "distribution": "uniform",
        "extent": [32, 64]
      },
      "z": {
        "distribution": "uniform",
        "extent": [-16, 0]
      },
      "scatter_chance": {
        "numerator": 1,
        "denominator": 2
      }
    }
  }
}
