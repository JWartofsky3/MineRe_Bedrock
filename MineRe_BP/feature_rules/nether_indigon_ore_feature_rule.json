{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:nether_indigon_ore_feature_rule",
      "places_feature": "minere:nether_indigon_ore_feature"
    },
    "conditions": {
      "placement_pass": "underground_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "hell"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "nether"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/50,v.originx/50); return (t.noise > 0.5) ? ((t.noise > 0.75) ? ((t.noise > 0.9) ? 16 : 12) : 8) : 0;",
      "coordinate_eval_order": "zyx",
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": {
        "distribution": "gaussian",
        "extent": [0, 100]
      },
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      }
    }
  }
}
