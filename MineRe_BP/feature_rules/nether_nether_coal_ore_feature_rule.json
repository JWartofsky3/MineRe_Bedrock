              "test": "has_biome_tag",
              "operator": "==",
              "value": "hell"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "nether"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/50 + 0, v.originx/50 + 0); return (t.noise > 0.74971198) ? 24 : (t.noise > 0.24996879) ? 12 : 0;",
      "coordinate_eval_order": "zyx",
      "x": {
        "distribution": "uniform",
        "extent": [
          0,
          16
        ]
      },
      "y": {
        "distribution": "gaussian",
        "extent": [
          0,
          196
        ]
      },
      "z": {
