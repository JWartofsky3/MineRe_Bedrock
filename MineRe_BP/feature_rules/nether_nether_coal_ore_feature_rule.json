{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:nether_nether_coal_ore_feature_rule",
      "places_feature": "minere:nether_coal_ore_feature"
    },
    "conditions": {
      "placement_pass": "underground_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "hell"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "nether"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/50,v.originx/50); return (t.noise > 0.4) ? ((t.noise > 0.65) ? ((t.noise > 0.85) ? 24 : 18) : 12) : 0;",
      "coordinate_eval_order": "zyx",
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": {
        "distribution": "gaussian",
        "extent": [0, 196]
      },
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      }
    }
  }
}
