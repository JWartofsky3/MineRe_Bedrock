{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:end_temple_feature_rule",
      "places_feature": "minere:end_temple_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "the_end"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "(Math.abs(v.originz) < 750 && Math.abs(v.originx) < 750) ? 0 : query.heightmap(v.originx, v.originz) < 60 ? 0 : 1",
      "x": -16,
      "y": {
        "distribution": "uniform",
        "extent": [
          "query.heightmap(variable.worldx, variable.worldz) - 2",
          "query.heightmap(variable.worldx, variable.worldz)"
        ]
      },
      "z": -16,
      "scatter_chance": {
        "numerator": 1,
        "denominator": 500
      }
    }
  }
}
