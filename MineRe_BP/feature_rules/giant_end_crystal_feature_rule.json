{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:giant_end_crystal_feature_rule",
      "places_feature": "minere:giant_end_crystal_weighted_feature"
    },
    "conditions": {
      "placement_pass": "underground_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "the_end"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/160,v.originx/160); return (Math.abs(v.originz) < 1000 && Math.abs(v.originx) < 1000) ? 0 : (t.noise < -0.95) ? 4 : (t.noise < -0.9) ? 2 : 0;",
      "x": {
        "distribution": "uniform",
        "extent": [-16, 0]
      },
      "y": {
        "distribution": "triangle",
        "extent": [0, 128]
      },
      "z": {
        "distribution": "uniform",
        "extent": [-16, 0]
      }
    }
  }
}
