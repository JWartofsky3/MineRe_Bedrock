{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:ice_caverns_feature_rule_frozen",
      "places_feature": "minere:ice_caverns_feature"
    },
    "conditions": {
      "placement_pass": "underground_pass",
      "minecraft:biome_filter": {
        "any_of": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "frozen"
          }
        ],
        "none_of": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "deep"
          },
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "lush_caves"
          }
        ]
      }
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/300,v.originx/300); t.mult = 1 + (query.heightmap(v.originx, v.originz) - 64)/64; return (t.noise < -0.35) ? (2000 * t.mult) : (t.noise < -0.25) ? (1400 * t.mult) : (t.noise < -0.1) ? (700 * t.mult) : 0;",
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": {
        "distribution": "uniform",
        "extent": [-8, "query.heightmap(variable.worldx, variable.worldz) - 16"]
      },
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      }
    }
  }
}
