{
  "format_version": "1.20.20",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "minere:ice_caverns_feature_rule_frozen",
      "places_feature": "minere:ice_caverns_feature"
    },
    "conditions": {
      "placement_pass": "underground_pass",
      "minecraft:biome_filter": {
        "any_of": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "frozen"
          }
        ],
        "none_of": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "ocean"
          },
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "river"
          },
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "beach"
          }
        ]
      }
    },
    "distribution": {
      "iterations": "t.noise = q.noise(v.originz/160,v.originx/160); t.mult = 1 + (query.heightmap(v.originx, v.originz) - 64)/64; return (t.noise < -0.4) ? (50 * t.mult) : (t.noise < -0.3) ? (25 * t.mult) : (t.noise < -0.15) ? (12 * t.mult) : 0;",
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": {
        "distribution": "uniform",
        "extent": [0, "query.heightmap(variable.worldx, variable.worldz) - 20"]
      },
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      }
    }
  }
}
