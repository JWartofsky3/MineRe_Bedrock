    "events": {
      "minere:saddled": {
        "add": {
          "component_groups": [
            "minere:skelephant_saddled"
          ]
        }
      },
      "minere:spawn_nether": {
        "add": {
          "component_groups": [
            "minere:skelephant_nether_equipment"
          ]
        }
      },
      "minere:start_stomp": {
        "filters": {
          "test": "bool_property",
          "domain": "minere:is_stomping",
          "value": false
        },
        "sequence": [
          {
            "set_property": {
              "minere:is_stomping": true
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:skelephant_stomping"
              ]
            }
          }
        ]
      },
      "minere:start_sinking": {
        "filters": {
          "test": "bool_property",
          "domain": "minere:is_sinking",
          "value": false
        },
        "sequence": [
          {
            "set_property": {
              "minere:is_sinking": true
            }
          },
          {
            "remove": {
              "component_groups": [
                "minere:skelephant_stomping"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:skelephant_sinking"
              ]
            }
          }
        ]
      },
      "minere:end_stomp": {
        "sequence": [
          {
            "set_property": {
              "minere:is_stomping": false
            }
          },
          {
            "remove": {
              "component_groups": [
                "minere:skelephant_stomping"
              ]
            }
          }
        ]
      }
    }
