{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minere:squirrel",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },

    "component_groups": {
      "baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.6
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "wheat_seeds",
            "beetroot_seeds",
            "melon_seeds",
            "pumpkin_seeds",
            "pitcher_pod",
            "torchflower_seeds",
            "minere:acorn"
          ],
          "grow_up": {
            "event": "grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 6,
          "speed_multiplier": 1.1
        }
      },

      "interactable_squirrel": {
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "minere:acorn"
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_component",
                      "subject": "self",
                      "operator": "!=",
                      "value": "minecraft:is_baby"
                    }
                  ]
                }
              },
              "barter": true,
              "admire": true,
              "use_item": true,
              "cooldown_after_being_attacked": 20,
              "interact_text": "action.interact.barter"
            }
          ]
        }
      },

      "adult": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1,7)",
          "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/squirrel.json"
        },
        "minecraft:shareables": {
          "items": [
            {
              "item": "minere:acorn",
              "priority": 1,
              "pickup_limit": 1,
              "admire": true,
              "barter": true
            }
          ]
        },
        "minecraft:admire_item": {
          "duration": 4,
          "cooldown_after_being_attacked": 20
        },
        "minecraft:behavior.admire_item": {
          "priority": 2,
          "admire_item_sound": "admire",
          "sound_interval": {
            "range_min": 2,
            "range_max": 5
          },
          "on_admire_item_start": {
            "event": "admire_item_started_event",
            "target": "self"
          },
          "on_admire_item_stop": {
            "event": "admire_item_stopped_event",
            "target": "self"
          }
        },
        "minecraft:behavior.barter": {
          "priority": 2
        },
        "minecraft:inventory": {
          "inventory_size": 8
        },
        "minecraft:barter": {
          "barter_table": "loot_tables/entities/squirrel_barter.json",
          "cooldown_after_being_attacked": 20
        },
        "minecraft:behavior.pickup_items": {
          "priority": 2,
          "max_dist": 10,
          "goal_radius": 2,
          "speed_multiplier": 0.8,
          "pickup_based_on_chance": false,
          "can_pickup_any_item": false,
          "cooldown_after_being_attacked": 20
        },
        "minecraft:behavior.breed": {
          "priority": 2,
          "speed_multiplier": 1.0
        },
        "minecraft:breedable": {
          "breed_items": [
            "wheat_seeds",
            "beetroot_seeds",
            "melon_seeds",
            "pumpkin_seeds",
            "pitcher_pod",
            "torchflower_seeds"
          ],
          "breeds_with": {
            "mate_type": "minere:squirrel",
            "baby_type": "minere:squirrel"
          },
          "require_tame": false,
          "mutation_factor": {
            "variant": 0.2
          }
        }
      },

      "red": {
        "minecraft:variant": { "value": 0 }
      },
      "gray": {
        "minecraft:variant": { "value": 1 }
      },
      "black": {
        "minecraft:variant": { "value": 2 }
      }
    },

    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": ["squirrel", "lightweight", "mob"]
      },

      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 3,
        "max": 3
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:collision_box": {
        "width": 0.67,
        "height": 0.67
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true
      },
      "minecraft:movement.skip": {},
      "minecraft:jump.dynamic": {},
      "minecraft:can_climb": {},
      "minecraft:leashable": {
        "soft_distance": 4.0,
        "hard_distance": 6.0,
        "max_distance": 10.0
      },
      "minecraft:balloonable": {
        "mass": 0.4
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 2.2
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 4,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 8,
            "walk_speed_multiplier": 1.5,
            "sprint_speed_multiplier": 1.8
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "wolf"
            },
            "max_dist": 4,
            "walk_speed_multiplier": 1.5,
            "sprint_speed_multiplier": 1.8
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 4,
            "walk_speed_multiplier": 1.5,
            "sprint_speed_multiplier": 1.5
          }
        ]
      },
      "minecraft:behavior.breed": {
        "priority": 2,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.tempt": {
        "priority": 3,
        "speed_multiplier": 1,
        "items": [
          "wheat_seeds",
          "beetroot_seeds",
          "melon_seeds",
          "pumpkin_seeds",
          "pitcher_pod",
          "torchflower_seeds",
          "minere:acorn"
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.6,
        "xz_dist": 2,
        "y_dist": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 11
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:block_climber": {}
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": { "component_groups": ["interactable_squirrel"] }
          },
          {
            "randomize": [
              {
                "weight": 3,
                "add": { "component_groups": ["adult"] }
              },
              {
                "weight": 1,
                "add": { "component_groups": ["baby"] }
              }
            ]
          },
          {
            "randomize": [
              {
                "weight": 2,
                "add": {
                  "component_groups": ["red"]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": ["gray"]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": ["black"]
                }
              }
            ]
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "cold"
                },
                {
                  "test": "has_biome_tag",
                  "value": "frozen"
                }
              ]
            },
            "randomize": [
              {
                "add": {
                  "component_groups": ["red"]
                }
              },
              {
                "weight": 3,
                "add": {
                  "component_groups": ["gray"]
                }
              },
              {
                "weight": 2,
                "add": {
                  "component_groups": ["black"]
                }
              }
            ]
          }
        ]
      },

      "minecraft:entity_born": {
        "sequence": [{ "add": { "component_groups": ["baby"] } }]
      },

      "grow_up": {
        "remove": { "component_groups": ["baby"] },
        "add": { "component_groups": ["adult"] }
      },

      "admire_item_started_event": {
        "remove": {
          "component_groups": ["interactable_squirrel"]
        }
      },
      "admire_item_stopped_event": {
        "add": {
          "component_groups": ["interactable_squirrel"]
        }
      }
    }
  }
}
