{
  "format_version": "1.19.20",
  "minecraft:entity": {
    "description": {
      "identifier": "minere:gremlin",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minere:big_gremlin": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 6 : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/gremlin.json"
        },
        "minecraft:scale": {
          "value": 1.5
        },
        "minecraft:health": {
          "value": 32,
          "max": 32
        },
        "minecraft:attack": {
          "damage": [6, 7]
        },
        "minecraft:knockback_resistance": {
          "value": 0.6
        }
      },
      "minere:medium_gremlin": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 3 : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/gremlin.json"
        },
        "minecraft:health": {
          "value": 18,
          "max": 18
        },
        "minecraft:attack": {
          "damage": [4, 5]
        },
        "minecraft:knockback_resistance": {
          "value": 0.15
        }
      },
      "minere:small_gremlin": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 2 : 0"
