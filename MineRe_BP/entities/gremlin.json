        "minecraft:scale": {
          "value": 0.75
        },
        "minecraft:health": {
          "value": 10,
          "max": 10
        },
        "minecraft:attack": {
          "damage": [2, 3]
        }
      },
      "minere:cave_gremlin": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "minere:nether_gremlin": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "minere:ender_gremlin": {
        "minecraft:variant": {
          "value": 2
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 3 : 0"
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": [
          "gremlin",
          "monster",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.2
      },
      "minecraft:movement": {
        "value": 0.23
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:follow_range": {
        "value": 12,
        "max": 12
      },
      "minecraft:attack": {
        "damage": 4
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "alert_same_type": true
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "speed_multiplier": 1.15,
        "reach_multiplier": 1.1,
        "track_target": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "must_see": true,
        "within_radius": 4,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "endermite"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "silverfish"
                }
              ]
            },
            "max_dist": 5
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:block_climber": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 5,
                "add": {
                  "component_groups": [
                    "minere:medium_gremlin"
                  ]
                }
              },
              {
                "weight": 2,
                "add": {
                  "component_groups": [
                    "minere:small_gremlin"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "minere:big_gremlin"
                  ]
                }
              }
            ]
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "overworld"
            },
            "add": {
              "component_groups": [
                "minere:cave_gremlin"
              ]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "nether"
            },
            "add": {
              "component_groups": [
                "minere:nether_gremlin"
              ]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "the_end"
            },
            "add": {
              "component_groups": [
                "minere:ender_gremlin"
              ]
            }
          }
        ]
