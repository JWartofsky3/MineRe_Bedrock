{
  "format_version": "1.19.20",
  "minecraft:entity": {
    "description": {
      "identifier": "minere:gremlin",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "angry": {
        "minecraft:angry": {
          "duration": 30,
          "broadcast_anger": true,
          "broadcast_anger_on_attack": true,
          "broadcast_anger_on_being_attacked": true,
          "broadcast_range": 32,
          "broadcast_targets": ["gremlin"],
          "calm_event": {
            "event": "become_calm_event",
            "target": "self"
          },
          "angry_sound": "angry",
          "sound_interval": {
            "range_min": 2,
            "range_max": 5
          }
        },
        "minecraft:on_target_escape": {
          "event": "become_calm_event",
          "target": "self"
        }
      },
      "alert_for_attack_targets": {
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "must_see": true,
        "within_radius": 24,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "endermite"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "silverfish"
                }
              ]
            },
            "max_dist": 8
          }
        ]
      }
      },
            "take_target_as_response_to_block_break": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 32
            }
          ]
        }
      },
      "minere:scared_of_blocks": {
        "minecraft:behavior.avoid_block": {
          "priority": 1,
          "tick_interval": 5,
          "search_range": 7,
          "search_height": 4,
          "walk_speed_modifier": 1.5,
          "sprint_speed_modifier": 1.5,
          "avoid_block_sound": "retreat",
          "sound_interval": {
            "range_min": 2,
            "range_max": 5
          },
          "target_selection_method": "nearest",
          "target_blocks": [
            "minecraft:soul_fire",
            "minecraft:item.soul_campfire",
            "minecraft:soul_torch",
            "minecraft:soul_lantern",
            "minecraft:portal",
            "minecraft:end_portal",
            "minecraft:carved_pumpkin",
            "minecraft:lit_pumpkin"
          ]
        }
      },
      "minere:scared_of_mobs": {
        "minecraft:behavior.avoid_mob_type": {
          "priority": 1,
          "avoid_mob_sound": "retreat",
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "bear"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "ogre"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "demon"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "lizord"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "walker"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "irongolem"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "wither"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "wither_skeleton"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "piglin"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "head",
                    "value": "carved_pumpkin"
                  }
                ]
              },
              "must_see": true,
              "max_dist": 6,
              "max_flee": 16,
              "walk_speed_multiplier": 1.3,
              "sprint_speed_multiplier": 1.5
            }
          ]
        }
      },
      "minere:scared_of_walkers": {
        "minecraft:behavior.avoid_mob_type": {
          "priority": 1,
          "avoid_mob_sound": "retreat",
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "walker"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "wither"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "head",
                    "value": "carved_pumpkin"
                  }
                ]
              },
              "must_see": true,
              "max_dist": 6,
              "max_flee": 16,
              "walk_speed_multiplier": 1.3,
              "sprint_speed_multiplier": 1.5
            }
          ]
        }
      },
      "minere:torch_breaker": {
        "minecraft:behavior.move_to_block": {
          "priority": 4,
          "search_range": 16,
          "search_height": 5,
          "tick_interval": 10,
          "goal_radius": 1.6,
          "target_blocks": ["torch"],
          "on_reach": [
            {
              "event": "minere:break_torches",
              "target": "self"
            }
          ]
        }
      },
      "minere:big_gremlin": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 6 : 0"
        },
        "minecraft:scale": {
          "value": 1.25
        },
        "minecraft:health": {
          "value": 36,
          "max": 36
        },
        "minecraft:attack": {
          "damage": [6, 7]
        },
        "minecraft:knockback_resistance": {
          "value": 0.5
        }
      },
      "minere:medium_gremlin": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 3 : 0"
        },
        "minecraft:health": {
          "value": 18,
          "max": 18
        },
        "minecraft:attack": {
          "damage": [4, 5]
        }
      },
      "minere:small_gremlin": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 2 : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/empty.json"
        },
        "minecraft:scale": {
          "value": 0.75
        },
        "minecraft:health": {
          "value": 10,
          "max": 10
        },
        "minecraft:attack": {
          "damage": [2, 3]
        }
      },
      "minere:cave_gremlin": {
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/gremlin/gremlin.json"
        }
      },
      "minere:nether_gremlin": {
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/gremlin/nether_gremlin.json"
        }
      },
      "minere:ender_gremlin": {
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/gremlin/ender_gremlin.json"
        }
      }
    },
    "components": {
      "minecraft:ambient_sound_interval": {
        "range": 8.0,
        "value": 4.0
      },
      "minecraft:follow_range": {
        "value": 24,
        "max": 24
      },
            "minecraft:block_sensor": {
          "sensor_radius": 16,
          "on_break": [
            {
              "block_list": [
                "minecraft:deepslate_coal_ore",
                "minecraft:coal_ore",
                "minecraft:warped_stem",
                "minecraft:chorus_plant",
                "minecraft:chorus_flower"
              ],
              "on_block_broken": "important_block_destroyed_event"
            }
          ]
        },
      "minecraft:on_target_acquired": {
        "event": "become_angry_event",
        "target": "self"
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 3 : 0"
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": ["gremlin", "monster", "mob"]
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.4
      },
      "minecraft:movement": {
        "value": 0.23
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:attack": {
        "damage": 4
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "alert_same_type": true
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 2,
        "speed_multiplier": 1.15,
        "horizontal_reach": 0.5
      },
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:block_climber": {},
      "minecraft:timer": {
        "looping": true,
        "randomInterval": true,
        "time": [7, 14],
        "time_down_event": {
          "event": "minere:change_mode"
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "minere:scared_of_blocks",
                "minere:scared_of_walkers",
                "alert_for_attack_targets"
              ]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "overworld"
            },
            "add": {
              "component_groups": ["minere:cave_gremlin"]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "nether"
            },
            "add": {
              "component_groups": ["minere:nether_gremlin"]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "the_end"
            },
            "add": {
              "component_groups": ["minere:ender_gremlin"]
            }
          },
          {
            "randomize": [
              {
                "weight": 5,
                "sequence": [
                  {
                    "add": {
                      "component_groups": ["minere:medium_gremlin"]
                    }
                  },
                  {
                    "randomize": [
                      {
                        "weight": 1,
                        "add": {
                          "component_groups": ["minere:scared_of_mobs"]
                        }
                      },
                      {
                        "weight": 15
                      }
                    ]
                  }
                ]
              },
              {
                "weight": 2,
                "sequence": [
                  {
                    "add": {
                      "component_groups": ["minere:small_gremlin"]
                    }
                  },
                  {
                    "randomize": [
                      {
                        "weight": 1,
                        "add": {
                          "component_groups": ["minere:scared_of_mobs"]
                        }
                      },
                      {
                        "weight": 5
                      }
                    ]
                  }
                ]
              },
              {
                "weight": 1,
                "sequence": [
                  {
                    "add": {
                      "component_groups": ["minere:big_gremlin"]
                    }
                  },
                  {
                    "randomize": [
                      {
                        "weight": 3,
                        "remove": {
                          "component_groups": ["minere:scared_of_blocks"]
                        }
                      },
                      {
                        "weight": 1
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "randomize": [
              {
                "weight": 3
              },
              {
                "weight": 4,
                "add": {
                  "component_groups": ["minere:torch_breaker"]
                }
              }
            ]
          }
        ]
      },
      "become_angry_event": {
        "add": {
          "component_groups": ["angry"]
        }
      },
      "become_calm_event": {
        "remove": {
          "component_groups": ["angry", "take_target_as_response_to_block_break"]
        },
        "add": {
          "component_groups": ["alert_for_attack_targets"]
        }
      },
            "important_block_destroyed_event": {
        "remove": {
          "component_groups": ["alert_for_attack_targets"]
        },
        "add": {
          "component_groups": ["take_target_as_response_to_block_break"]
        }
      },
      "minere:change_mode": {
        "randomize": [
          {
            "weight": 3,
            "remove": {
              "component_groups": ["minere:torch_breaker"]
            }
          },
          {
            "weight": 4,
            "add": {
              "component_groups": ["minere:torch_breaker"]
            }
          }
        ]
      },
      "minere:break_torches": {},
      "minere:play_attack_animation": {
        "queue_command": {
          "command": "playanimation @s animation.minere.gremlin.attack"
        }
      }
    }
  }
}
