        "randomize": [
          {
            "weight": 9,
            "trigger": "minecraft:spawn_adult"
          },
          {
            "weight": 1,
            "remove": {},
            "add": {
              "component_groups": [
                "minere:whale_baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "remove": {},
        "add": {
          "component_groups": [
            "minere:whale_baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "minere:whale_baby"
          ]
        },
        "add": {
          "component_groups": [
            "minere:whale_adult"
          ]
        }
      },
      "minecraft:spawn_adult": {
        "add": {
          "component_groups": [
            "minere:whale_adult"
          ]
        }
