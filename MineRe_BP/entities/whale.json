        "minecraft:movement": {
          "value": 0.2
        },
        "minecraft:underwater_movement": {
          "value": 0.2
        },
        "minecraft:knockback_resistance": {
          "value": 0.9
        },
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? Math.Random(15,40) : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/whale/whale.json"
        }
      }
