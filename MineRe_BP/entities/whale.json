        "can_path_over_water": false,
        "can_swim": true,
        "can_walk": false,
        "can_breach": true,
        "can_sink": false
      },
      "minecraft:physics": {
        "has_gravity": true
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:movement.sway": {
        "sway_amplitude": 0.01
      },
      "minecraft:behavior.swim_idle": {
        "priority": 5,
        "idle_time": 5,
        "success_rate": 0.01
      },
      "minecraft:behavior.random_swim": {
        "priority": 3,
        "speed_multiplier": 1,
        "xz_dist": 64,
        "y_dist": 8,
        "interval": 0
      },
      "minecraft:behavior.swim_wander": {
        "priority": 4,
        "interval": 0.03,
        "look_ahead": 16,
        "speed_multiplier": 1,
        "wander_time": 5
