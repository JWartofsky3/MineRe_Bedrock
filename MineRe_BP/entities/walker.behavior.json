{
	"format_version": "1.21.2",
	"minecraft:entity": {
	  "description": {
		"identifier": "minere:walker",
		"is_spawnable": true,
		"is_summonable": true,
		"is_experimental": false
	  },
	  "component_groups": {
		"hostile": {
		  "minecraft:variant": {
			"value": 0
		  },
		  "minecraft:type_family": {
			"family": [
			  "walker",
			  "mob",
			  "monster"
			]
		  },
		  "minecraft:behavior.hurt_by_target": {
			"priority": 1
		  },
		  "minecraft:behavior.nearest_attackable_target": {
			"priority": 2,
			"within_radius": 32,
			"entity_types": [
			  {
				"filters": {
				  "any_of": [
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "player"
					},
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "villager"
					},
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "irongolem"
					}
				  ]
				},
				"max_dist": 64
			  }
			],
			"must_see": true
		  },
		  "minecraft:interact": {
			"interactions": {
			  "on_interact": {
				"filters": {
				  "all_of": [
					{
					  "test": "has_equipment",
					  "domain": "hand",
					  "subject": "other",
					  "value": "ender_eye"
					}
				  ]
				},
				"event": "reprogram",
				"target": "self"
			  },
			  "use_item": true,
			  "interact_text": "action.interact.reprogram"
			}
		  }
		},
		"reprogramming": {
		  "minecraft:attack_cooldown": {
			"attack_cooldown_complete_event": {
			  "event": "become_friendly",
			  "target": "self"
			},
			"attack_cooldown_time": 7
		  },
		  "minecraft:is_shaking": {}
		},
		"friendly": {
		  "minecraft:variant": {
			"value": 1
		  },
		  "minecraft:type_family": {
			"family": [
			  "walker",
			  "mob"
			]
		  },
		  "minecraft:persistent": {},
		  "minecraft:behavior.hurt_by_target": {
			"priority": 2,
			"entity_types": {
			  "filters": {
				"test": "is_family",
				"subject": "other",
				"operator": "!=",
				"value": "player"
			  }
			}
		  },
		  "minecraft:behavior.nearest_attackable_target": {
			"priority": 2,
			"within_radius": 32,
			"entity_types": [
			  {
				"filters": {
				  "all_of": [
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "monster"
					}
				  ],
				  "none_of": [
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "enderman"
					},
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "gremlin"
					},
					{
					  "test": "is_family",
					  "subject": "other",
					  "operator": "==",
					  "value": "player"
					}
				  ]
				},
				"max_dist": 64
			  }
			],
			"must_see": true
		  },
		  "minecraft:interact": {
			"interactions": [
			  {
				"on_interact": {
				  "filters": {
					"all_of": [
					  {
						"test": "is_family",
						"subject": "other",
						"value": "player"
					  },
					  {
						"test": "has_equipment",
						"domain": "hand",
						"subject": "other",
						"value": "end_stone"
					  },
					  {
						"test": "is_missing_health",
						"value": true
					  }
					]
				  }
				},
				"use_item": true,
				"health_amount": 20,
				"play_sounds": "walker.hurt",
				"interact_text": "action.interact.repair"
			  }
			]
		  }
		},
		"emerging": {
		  "minecraft:behavior.emerge": {
			"duration": 3,
			"on_done": {
			  "event": "minere:emerged",
			  "target": "self"
			}
		  },
		  "minecraft:pushable": {
			"is_pushable": false,
			"is_pushable_by_piston": false
		  }
		},
		"immobile": {
		  "minecraft:movement": {
			"value": 0
		  },
		  "minecraft:pushable": {
			"is_pushable": false,
			"is_pushable_by_piston": false
		  }
		},
		"can_move": {
		  "minecraft:pushable": {
			"is_pushable": true,
			"is_pushable_by_piston": true
		  },
		  "minecraft:movement": {
			"value": 0.25
		  },
		  "minecraft:follow_range": {
			"value": 64,
			"max": 64
		  },
		  "minecraft:navigation.walk": {
			"is_amphibious": true,
			"can_path_over_water": false,
			"avoid_water": true,
			"avoid_damage_blocks": true
		  },
		  "minecraft:movement.basic": {},
		  "minecraft:jump.static": {},
		  "minecraft:can_climb": {},
		  "minecraft:leashable": {
			"soft_distance": 4,
			"hard_distance": 6,
			"max_distance": 10
		  },
		  "minecraft:behavior.random_stroll": {
			"priority": 7,
			"speed_multiplier": 1
		  },
		  "minecraft:behavior.look_at_player": {
			"priority": 8,
			"look_distance": 6,
			"probability": 0.02
		  },
		  "minecraft:behavior.random_look_around": {
			"priority": 9
		  }
		},
		"mode_switcher": {
		  "minecraft:target_nearby_sensor": {
			"inside_range": 4.5,
			"outside_range": 5,
			"must_see": true,
			"on_inside_range": {
			  "event": "switch_to_melee",
			  "target": "self"
			},
			"on_outside_range": {
			  "event": "switch_to_ranged",
			  "target": "self"
			}
		  }
		},
		"ranged_mode": {
		  "minecraft:shooter": {
			"def": "minere:plasma_bolt"
		  },
		  "minecraft:behavior.ranged_attack": {
			"priority": 3,
			"attack_radius": 64,
			"burst_shots": 2,
			"burst_interval": 0.5,
			"charge_shoot_trigger": 1.5,
			"charge_charged_trigger": 1
		  }
		},
		"melee_mode": {
		  "minecraft:attack": {
			"damage": 11
		  },
		  "minecraft:behavior.delayed_attack": {
			"priority": 3,
			"attack_duration": 1,
			"attack_once": false,
			"cooldown_time": 2,
			"track_target": true,
			"require_complete_path": false,
			"random_stop_interval": 0,
			"reach_multiplier": 2,
			"speed_multiplier": 1.25,
			"hit_delay_pct": 0.25
		  }
		}
	  },
	  "components": {
		"minecraft:nameable": {},
		"minecraft:loot": {
		  "table": "loot_tables/entities/walker.json"
		},
		"minecraft:experience_reward": {
		  "on_death": "query.last_hit_by_player ? 40 : 0"
		},
		"minecraft:health": {
		  "value": 150,
		  "max": 150
		},
		"minecraft:damage_sensor": {
		  "triggers": [
			{
			  "cause": "entity_explosion",
			  "damage_multiplier": 1.5
			},
			{
			  "cause": "block_explosion",
			  "damage_multiplier": 1.5
			},
			{
			  "cause": "projectile",
			  "damage_multiplier": 0.75
			}
		  ]
		},
		"minecraft:attack": {
		  "damage": [
			7,
			10
		  ]
		},
		"minecraft:knockback_resistance": {
		  "value": 0.8
		},
		"minecraft:type_family": {
		  "family": [
			"walker",
			"mob",
			"monster"
		  ]
		},
		"minecraft:collision_box": {
		  "width": 3,
		  "height": 8
		},
		"minecraft:shooter": {
		  "def": "minere:plasma_bolt"
		},
		"minecraft:breathable": {
		  "total_supply": 15,
		  "suffocate_time": 0,
		  "breathes_water": true
		},
		"minecraft:fire_immune": {},
		"minecraft:despawn": {
		  "filters": {
			"any_of": [
			  {
				"all_of": [
				  {
					"test": "is_persistent",
					"value": false
				  },
				  {
					"test": "distance_to_nearest_player",
					"operator": ">",
					"value": 256
				  }
				]
			  },
			  {
				"all_of": [
				  {
					"test": "is_persistent",
					"value": false
				  },
				  {
					"test": "inactivity_timer",
					"subject": "self",
					"value": 45
				  },
				  {
					"test": "random_chance",
					"value": 1200
				  },
				  {
					"test": "distance_to_nearest_player",
					"operator": ">",
					"value": 128
				  }
				]
			  }
			]
		  }
		},
		"minecraft:physics": {},
		"minecraft:conditional_bandwidth_optimization": {}
	  },
	  "events": {
		"minecraft:entity_spawned": {
		  "add": {
			"component_groups": [
			  "emerging",
			  "hostile",
			  "immobile"
			]
		  }
		},
		"reprogram": {
		  "randomize": [
			{
			  "weight": 1,
			  "remove": {
				"component_groups": [
				  "hostile",
				  "can_move",
				  "mode_switcher",
				  "melee_mode",
				  "ranged_mode"
				]
			  },
			  "add": {
				"component_groups": [
				  "reprogramming",
				  "immobile"
				]
			  },
			  "queue_command": {
				"command": "playsound mob.walker.reprogram @a ~ ~ ~ 2.0"
			  }
			},
			{
			  "weight": 2,
			  "queue_command": {
				"command": "playsound item.amethyst_staff.error @a ~ ~ ~ 2.0"
			  }
			}
		  ]
		},
		"become_friendly": {
		  "sequence": [
			{
			  "remove": {
				"component_groups": [
				  "immobile",
				  "reprogramming"
				]
			  }
			},
			{
			  "add": {
				"component_groups": [
				  "friendly",
				  "can_move",
				  "mode_switcher"
				]
			  }
			},
			{
			  "queue_command": {
				"command": "playsound mob.walker.reprogram_complete @a ~ ~ ~ 2.0"
			  }
			},
			{
			  "queue_command": {
				"command": "summon endermite"
			  }
			}
		  ]
		},
		"switch_to_melee": {
		  "remove": {
			"component_groups": [
			  "ranged_mode"
			]
		  },
		  "add": {
			"component_groups": [
			  "melee_mode"
			]
		  }
		},
		"switch_to_ranged": {
		  "remove": {
			"component_groups": [
			  "melee_mode"
			]
		  },
		  "add": {
			"component_groups": [
			  "ranged_mode"
			]
		  }
		},
		"minecraft:spawn_emerging": {
		  "add": {
			"component_groups": [
			  "emerging"
			]
		  }
		},
		"minere:emerged": {
		  "remove": {
			"component_groups": [
			  "emerging",
			  "immobile"
			]
		  },
		  "add": {
			"component_groups": [
			  "can_move",
			  "mode_switcher"
			]
		  }
		}
	  }
	}
  }