    "components": {
      "minecraft:type_family": {
        "family": ["firefly", "arthropod", "mob"]
      },
      "minecraft:equipment": {
        "table": "loot_tables/entities/firefly.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player?3:0"
      },
      "minecraft:movement": {
        "value": 0.23
      },
      "minecraft:health": {
        "value": 6,
        "max": 6
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:collision_box": {
        "width": 1,
        "height": 1
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "fall",
          "deals_damage": false
        }
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:follow_range": {
        "value": 16,
        "max": 16
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:movement.hover": {},
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_pass_doors": false,
        "can_path_from_air": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "avoid_sun": false
      },
      "minecraft:flying_speed": {
        "value": 0.2
      },
      "minecraft:can_fly": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.tempt": {
        "priority": 3,
        "speed_multiplier": 1.25,
        "within_radius": 8,
        "can_tempt_vertically": true,
        "items": [
          "minecraft:slime_ball",
          "minecraft:magma_cream",
          "minecraft:glowstone_dust"
        ]
      },
      "minecraft:behavior.random_hover": {
        "priority": 4,
        "xz_dist": 8,
        "y_dist": 8,
        "interval": 1,
        "hover_height": [2, 4]
      },
      "minecraft:behavior.look_at_target": {
        "priority": 6,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:physics": {
        "has_gravity": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true,
        "emit_move": true,
        "emit_swim": true
      }
    },
    "events": {
      "add_base_components": {
        "add": {
          "component_groups": ["minere:firefly_walking", "minere:firefly_adult"]
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "trigger": "add_base_components"
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "mangrove_swamp"
                },
                {
                  "test": "has_biome_tag",
                  "value": "jungle"
                },
                {
                  "test": "has_biome_tag",
                  "value": "savanna"
                }
              ]
            },
            "trigger": "spawn_yellow"
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "cold"
                },
                {
                  "test": "has_biome_tag",
                  "value": "frozen"
                }
              ]
            },
            "trigger": "spawn_blue"
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "warped_forest"
            },
            "trigger": "spawn_purple"
          }
        ]
      },
      "spawn_green": {
        "add": {
          "component_groups": ["minere:green_firefly"]
        },
        "trigger": "add_base_components"
      },
      "spawn_yellow": {
        "add": {
          "component_groups": ["minere:yellow_firefly"]
        },
        "trigger": "add_base_components"
      },
      "spawn_purple": {
        "add": {
          "component_groups": ["minere:purple_firefly"]
        },
        "trigger": "add_base_components"
      },
      "spawn_blue": {
        "add": {
          "component_groups": ["minere:blue_firefly"]
        },
        "trigger": "add_base_components"
      },
      "minecraft:entity_born": {
        "add": {
          "component_groups": ["minere:firefly_walking", "minere:firefly_baby"]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": ["minere:firefly_baby"]
        },
        "add": {
          "component_groups": ["minere:firefly_adult"]
        }
      },
      "start_flying": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:firefly_walking",
                "minere:firefly_flying"
              ]
            }
          },
          {
            "add": {
              "component_groups": ["minere:firefly_flying"]
            }
          }
        ]
      },
      "start_walking": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:firefly_flying",
                "minere:firefly_walking"
              ]
            }
          },
          {
            "add": {
              "component_groups": ["minere:firefly_walking"]
            }
          }
        ]
      },
      "despawn": {
        "sequence": [
          {
            "add": {
              "component_groups": ["instant_despawn"]
            }
          }
        ]
      }
    }
  }
}
