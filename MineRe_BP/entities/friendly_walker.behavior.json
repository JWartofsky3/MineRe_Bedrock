{
  "format_version": "1.21.2",
  "minecraft:entity": {
    "description": {
      "identifier": "minere:friendly_walker",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minere:commandable": {
        "minecraft:tameable": {
          "probability": 0,
          "tame_items": "minecraft:barrier",
          "tame_event": {
            "event": "minere:on_take_command",
            "target": "self"
          }
        }
      },
      "minere:commanded": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2
        }
      },
      "minere:following_owner": {
        "minecraft:behavior.follow_owner": {
          "priority": 1,
          "speed_multiplier": 1.5,
          "start_distance": 16,
          "stop_distance": 8
        }
      },
      "minere:patrol": {
        "minecraft:behavior.random_stroll": {
          "priority": 7,
          "speed_multiplier": 1,
          "xz_dist": 24
        }
      },
      "minere:hostile_targets": {
        "minecraft:behavior.hurt_by_target": {
          "priority": 2,
          "entity_types": {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "player"
            }
          }
        },
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 2,
          "within_radius": 64,
          "reevaluate_description": true,
          "must_see": true,
          "entity_types": [
            {
              "priority": 0,
              "max_dist": 48,
              "reevaluate_description": true,
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "walker"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "friendly_walker"
                  }
                ]
              }
            },
            {
              "priority": 1,
              "max_dist": 48,
              "reevaluate_description": true,
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "monster"
                  }
                ],
                "none_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "enderman"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "gremlin"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "shulker"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "stomp"
                  }
                ]
              }
            },
            {
              "priority": 1,
              "max_dist": 8,
              "reevaluate_description": true,
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "enderman"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "stomp"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "==",
                    "value": "endermite"
                  }
                ]
              }
            }
          ]
        }
      },
      "minere:monster_targets": {
        "minecraft:behavior.hurt_by_target": {
          "priority": 2,
          "entity_types": {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "player"
            }
          }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_reach": true,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 48
            }
          ]
        }
      },
      "can_move": {
        "minecraft:pushable": {
          "is_pushable": true,
          "is_pushable_by_piston": true
        },
        "minecraft:movement": {
          "value": 0.27
        },
        "minecraft:follow_range": {
          "value": 48,
          "max": 48
        },
        "minecraft:navigation.walk": {
          "is_amphibious": true,
          "can_path_over_water": false,
          "avoid_water": true,
          "avoid_damage_blocks": true
        },
        "minecraft:movement.basic": {},
        "minecraft:jump.static": {},
        "minecraft:can_climb": {},
        "minecraft:behavior.look_at_player": {
          "priority": 8,
          "look_distance": 6,
          "probability": 0.02
        },
        "minecraft:behavior.random_look_around": {
          "priority": 9
        }
      },
      "mode_switcher": {
        "minecraft:target_nearby_sensor": {
          "inside_range": 5,
          "outside_range": 6,
          "must_see": true,
          "on_inside_range": {
            "event": "switch_to_melee",
            "target": "self"
          },
          "on_outside_range": {
            "event": "switch_to_ranged",
            "target": "self"
          }
        }
      },
      "ranged_mode": {
        "minecraft:shooter": {
          "def": "minere:plasma_bolt"
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 3,
          "attack_radius": 64,
          "burst_shots": 2,
          "burst_interval": 0.5,
          "charge_shoot_trigger": 1.5,
          "charge_charged_trigger": 1
        }
      },
      "melee_mode": {
        "minecraft:attack": {
          "damage": 8
        },
        "minecraft:behavior.delayed_attack": {
          "priority": 3,
          "attack_duration": 1.5,
          "attack_once": false,
          "cooldown_time": 0.5,
          "track_target": true,
          "require_complete_path": false,
          "random_stop_interval": 0,
          "reach_multiplier": 2,
          "speed_multiplier": 1.25,
          "hit_delay_pct": 0.5
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/walker.json"
      },
      "minecraft:equipment": {
        "table": "loot_tables/entities/ogre/ogre_gear.json",
        "slot_drop_chance": [
          {
            "slot": "slot.weapon.mainhand",
            "drop_chance": 0.0
          }
        ]
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 50 : 0"
      },
      "minecraft:health": {
        "value": 150,
        "max": 150
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "damage_multiplier": 0.75
          }
        ]
      },
      "minecraft:attack": {
        "damage": [
          7,
          10
        ]
      },
      "minecraft:knockback_resistance": {
        "value": 0.8
      },
      "minecraft:type_family": {
        "family": [
          "friendly_walker",
          "walker",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 3,
        "height": 8
      },
      "minecraft:shooter": {
        "def": "minere:plasma_bolt"
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true
      },
      "minecraft:fire_immune": {},
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:leashable": {
        "soft_distance": 12,
        "hard_distance": 20,
        "max_distance": 32
      },
      "minecraft:behavior.tempt": {
        "priority": 0,
        "speed_multiplier": 1.5,
        "items": [
          "ender_eye"
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "any_of": [
                      {
                        "test": "has_equipment",
                        "domain": "hand",
                        "subject": "other",
                        "value": "end_stone"
                      },
                      {
                        "test": "has_equipment",
                        "domain": "hand",
                        "subject": "other",
                        "value": "end_bricks"
                      }
                    ]
                  },
                  {
                    "test": "is_missing_health",
                    "value": true
                  }
                ]
              }
            },
            "use_item": true,
            "health_amount": 15,
            "play_sounds": "irongolem.repair",
            "interact_text": "action.interact.repair"
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_sneaking",
                    "subject": "other",
                    "value": false
                  },
                  {
                    "none_of": [
                      {
                        "test": "has_equipment",
                        "domain": "hand",
                        "subject": "other",
                        "value": "end_stone"
                      },
                      {
                        "test": "has_equipment",
                        "domain": "hand",
                        "subject": "other",
                        "value": "end_bricks"
                      }
                    ]
                  }
                ]
              },
              "event": "minere:from_player",
              "target": "self"
            },
            "use_item": false,
            "interact_text": "action.interact.reprogram"
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "can_move",
            "mode_switcher",
            "minere:patrol",
            "minere:hostile_targets"
          ]
        }
      },
      "minere:take_command": {
        "add": {
          "component_groups": [
            "minere:commandable"
          ]
        }
      },
      "minere:from_player": {},
      "minere:on_take_command": {
        "add": {
          "component_groups": [
            "minere:commanded"
          ]
        }
      },
      "minere:relinquish_command": {
        "remove": {
          "component_groups": [
            "minere:commandable",
            "minere:commanded",
            "minere:following_owner"
          ]
        }
      },
      "minere:follow_owner": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:patrol"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:following_owner"
              ]
            }
          }
        ]
      },
      "minere:stay_here": {
        "remove": {
          "component_groups": [
            "minere:following_owner",
            "minere:patrol"
          ]
        }
      },
      "minere:patrol": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:following_owner"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:patrol"
              ]
            }
          }
        ]
      },
      "minere:enable_attack_hostile": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:monster_targets"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:hostile_targets"
              ]
            }
          }
        ]
      },
      "minere:enable_attack_monsters": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:hostile_targets"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:monster_targets"
              ]
            }
          }
        ]
      },
      "minere:enable_attack_only_owner_target": {
        "remove": {
          "component_groups": [
            "minere:hostile_targets",
            "minere:monster_targets"
          ]
        }
      },
      "switch_to_melee": {
        "remove": {
          "component_groups": [
            "ranged_mode"
          ]
        },
        "add": {
          "component_groups": [
            "melee_mode"
          ]
        }
      },
      "switch_to_ranged": {
        "remove": {
          "component_groups": [
            "melee_mode"
          ]
        },
        "add": {
          "component_groups": [
            "ranged_mode"
          ]
        }
      }
    }
  }
}