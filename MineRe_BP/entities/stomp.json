{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minere:stomp",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minere:stomp": {
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/stomp/sand_stomp.json"
        }
      },
      "minere:red_stomp": {
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/stomp/red_stomp.json"
        }
      },
      "minere:end_stomp": {
        "minecraft:variant": {
          "value": 2
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/stomp/end_stomp.json"
        }
      },
      "minere:soul_stomp": {
        "minecraft:variant": {
          "value": 3
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/stomp/soul_stomp.json"
        },
        "minecraft:fire_immune": {}
      },
      "minere:calm": {
        "minecraft:movement.jump": {
          "jump_delay": [4, 6]
        }
      },
      "minere:aggressive": {
        "minecraft:movement.jump": {
          "jump_delay": [1, 2]
        }
      }
    },
    "components": {
      "minecraft:knockback_resistance": {
        "value": 0.6
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:collision_box": {
        "width": 2.08,
        "height": 2.08
      },
      "minecraft:attack": {
        "damage": 6
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5"
      },
      "minecraft:type_family": {
        "family": ["stomp", "monster", "mob"]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true
      },
      "minecraft:spell_effects": {
        "add_effects": [
          {
            "effect": "jump_boost",
            "duration": 999999,
            "amplifier": 5,
            "visible": false,
            "display_on_screen_animation": false
          }
        ]
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},

      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": true,
            "damage_modifier": -7
          },
          {
            "cause": "entity_explosion",
            "damage_multiplier": 1.25
          },
          {
            "cause": "block_explosion",
            "damage_multiplier": 1.25
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "any_of": [
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "wooden_pickaxe"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "stone_pickaxe"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "iron_pickaxe"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "golden_pickaxe"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "diamond_pickaxe"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "netherite_pickaxe"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "mace"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "other",
                        "domain": "hand",
                        "value": "minere:enderon_pickaxe"
                      }
                    ]
                  }
                ]
              }
            },
            "cause": "entity_attack",
            "damage_multiplier": 3.0,
            "damage_modifier": 0
          }
        ]
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          },
          {
            "filters": {
              "test": "in_contact_with_water",
              "operator": "==",
              "value": true
            },
            "cause": "drowning",
            "damage_per_tick": 1
          }
        ]
      },
      "minecraft:movement.jump": {
        "jump_delay": [2.0, 6.0]
      },
      "minecraft:on_target_acquired": {
        "event": "minecraft:become_aggressive",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "minecraft:become_calm",
        "target": "self"
      },
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.slime_float": {
        "priority": 1,
        "jump_chance_percentage": 0.8,
        "speed_multiplier": 1.2
      },
      "minecraft:behavior.slime_attack": {
        "priority": 3
      },
      "minecraft:area_attack": {
        "damage_range": 0.15,
        "damage_per_tick": 8,
        "damage_cooldown": 2.0,
        "cause": "entity_attack",
        "entity_filter": {
          "any_of": [
            { "test": "is_family", "subject": "other", "value": "player" },
            { "test": "is_family", "subject": "other", "value": "irongolem" }
          ]
        }
      },
      "minecraft:behavior.slime_random_direction": {
        "priority": 4,
        "add_random_time_range": 3,
        "turn_range": 360,
        "min_change_direction_time": 2
      },
      "minecraft:behavior.slime_keep_on_jumping": {
        "priority": 5,
        "speed_multiplier": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "snowgolem"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "irongolem"
                }
              ]
            },
            "max_dist": 16
          }
        ],
        "must_see": true
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": ["minere:calm", "minere:stomp"]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "mesa"
            },
            "remove": {
              "component_groups": ["minere:stomp"]
            },
            "add": {
              "component_groups": ["minere:red_stomp"]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "the_end"
            },
            "remove": {
              "component_groups": ["minere:stomp"]
            },
            "add": {
              "component_groups": ["minere:end_stomp"]
            }
          },
          {
            "filters": {
              "test": "has_biome_tag",
              "value": "nether"
            },
            "remove": {
              "component_groups": ["minere:stomp"]
            },
            "add": {
              "component_groups": ["minere:soul_stomp"]
            }
          }
        ]
      },
      "minecraft:become_calm": {
        "add": {
          "component_groups": ["minere:calm"]
        }
      },
      "minecraft:become_aggressive": {
        "add": {
          "component_groups": ["minere:aggressive"]
        }
      }
    }
  }
}
