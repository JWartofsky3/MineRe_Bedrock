{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "runtime_identifier": "minecraft:sheep",
      "identifier": "minere:deer",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minere:deer_brown": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "minere:deer_light": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "minere:deer_red": {
        "minecraft:variant": {
          "value": 2
        }
      },
      "minere:deer_white": {
        "minecraft:variant": {
          "value": 3
        }
      },
      "minere:deer_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "apple"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 6,
          "speed_multiplier": 1.2
        }
      },
      "minere:deer_adult": {
        "minecraft:scale": {
          "value": 1
        },
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1,7)",
          "on_death": "query.last_hit_by_player ? Math.Random(1,5) : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/deer.json"
        }
      },
      "minere:deer_wild": {
        "minecraft:trusting": {
          "probability": 0.33,
          "trust_items": [
            "apple"
          ],
          "trust_event": {
            "event": "minecraft:on_trust",
            "target": "self"
          }
        },
        "minecraft:behavior.tempt": {
          "priority": 4,
          "can_get_scared": true,
          "speed_multiplier": 0.5,
          "items": [
            "apple"
          ]
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 5,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "bear"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "wolf"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "dire_wolf"
                  }
                ]
              },
              "must_see": true,
              "max_dist": 6,
              "max_flee": 16,
              "walk_speed_multiplier": 1.8,
              "sprint_speed_multiplier": 2.1
            }
          ]
        }
      },
      "minere:deer_trusting": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.breed": {
          "priority": 3,
          "speed_multiplier": 1
        },
        "minecraft:behavior.tempt": {
          "priority": 4,
          "can_get_scared": true,
          "speed_multiplier": 0.9,
          "items": [
            "apple"
          ]
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 5,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "bear"
              },
              "must_see": true,
              "max_dist": 6,
              "max_flee": 16,
              "walk_speed_multiplier": 1.8,
              "sprint_speed_multiplier": 2.1
            }
          ]
        },
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": "apple",
          "breeds_with": {
            "mate_type": "minere:deer",
            "baby_type": "minere:deer",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          }
        }
      },
      "minere:deer_unsaddled": {
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "saddle"
                    },
                    {
                      "test": "has_component",
                      "subject": "self",
                      "value": "minecraft:is_tamed"
                    }
                  ]
                },
                "event": "minecraft:on_saddled"
              },
              "use_item": true,
              "play_sounds": "saddle",
              "interact_text": "action.interact.saddle"
            }
          ]
        }
      },
      "minere:deer_saddled": {
        "minecraft:is_saddled": {},
        "minecraft:type_family": {
          "family": [
            "deer",
            "mob",
            "saddled"
          ]
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": true,
          "on_rider_exit_event": "minere:on_rider_exit",
          "family_types": [
            "goblin"
          ],
          "interact_text": "action.interact.ride.horse",
          "seats": {
            "lock_rider_rotation": true,
            "position": [
              0,
              0.8,
              -0.2
            ]
          }
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "shears"
                    },
                    {
                      "test": "rider_count",
                      "subject": "self",
                      "operator": "equals",
                      "value": 0
                    }
                  ]
                },
                "event": "minecraft:on_unsaddled"
              },
              "hurt_item": 1,
              "spawn_items": {
                "table": "loot_tables/entities/deer_saddle.json"
              },
              "interact_text": "action.interact.removesaddle",
              "play_sounds": "shear",
              "vibration": "shear"
            }
          ]
        }
      },
      "minere:deer_cavalry": {
        "minecraft:addrider": {
          "entity_type": "minere:goblin",
          "spawn_event": "become_cavalry"
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "deer",
          "mob"
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 14,
        "max": 14
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "damager",
                    "value": "goblin"
                  },
                  {
                    "any_of": [
                      {
                        "test": "has_equipment",
                        "subject": "damager",
                        "domain": "hand",
                        "value": "minecraft:stone_spear"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "damager",
                        "domain": "hand",
                        "value": "minecraft:copper_spear"
                      },
                      {
                        "test": "has_equipment",
                        "subject": "damager",
                        "domain": "hand",
                        "value": "minecraft:iron_spear"
                      }
                    ]
                  }
                ]
              }
            },
            "deals_damage": false
          }
        ]
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.5
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:balloonable": {
        "mass": 0.75
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 2
      },
      "minecraft:behavior.mount_pathing": {
        "priority": 0,
        "speed_multiplier": 1.4,
        "target_dist": 0,
        "track_target": true
      },
      "minecraft:behavior.eat_block": {
        "priority": 6,
        "success_chance": "0.001",
        "time_until_eat": 1.8,
        "eat_and_replace_block_pairs": [
          {
            "eat_block": "grass",
            "replace_block": "dirt"
          },
          {
            "eat_block": "tallgrass",
            "replace_block": "air"
          }
        ],
        "on_eat": {
          "event": "minecraft:on_eat_block",
          "target": "self"
        }
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 95,
                "trigger": "minecraft:spawn_adult"
              },
              {
                "weight": 5,
                "trigger": "minecraft:spawn_baby"
              }
            ]
          },
          {
            "trigger": "minere:select_spawn_variant"
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "minere:deer_baby",
                "minere:deer_trusting",
                "minere:deer_unsaddled"
              ]
            }
          },
          {
            "trigger": "minere:select_spawn_variant"
          }
        ]
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "minere:deer_baby"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_adult"
          ]
        }
      },
      "minecraft:spawn_adult": {
        "add": {
          "component_groups": [
            "minere:deer_adult",
            "minere:deer_wild"
          ]
        }
      },
      "minecraft:spawn_baby": {
        "add": {
          "component_groups": [
            "minere:deer_baby",
            "minere:deer_wild"
          ]
        }
      },
      "minecraft:on_trust": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minere:deer_wild"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "minere:deer_trusting",
                "minere:deer_unsaddled"
              ]
            }
          }
        ]
      },
      "minecraft:on_saddled": {
        "remove": {
          "component_groups": [
            "minere:deer_unsaddled"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_saddled"
          ]
        }
      },
      "minecraft:on_unsaddled": {
        "remove": {
          "component_groups": [
            "minere:deer_saddled",
            "minere:deer_cavalry"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_unsaddled"
          ]
        }
      },
      "minere:on_rider_exit": {
        "sequence": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "goblin"
            },
            "remove": {
              "component_groups": [
                "minere:deer_cavalry"
              ]
            }
          }
        ]
      },
      "become_cavalry": {
        "remove": {
          "component_groups": [
            "minere:deer_wild",
            "minere:deer_baby",
            "minere:deer_unsaddled"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_adult",
            "minere:deer_trusting",
            "minere:deer_saddled",
            "minere:deer_cavalry"
          ]
        }
      },
      "minere:select_spawn_variant": {
        "sequence": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "cold"
                },
                {
                  "test": "has_biome_tag",
                  "value": "frozen"
                }
              ]
            },
            "trigger": "minere:set_white_variant"
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "has_biome_tag",
                  "value": "roofed"
                }
              ],
              "none_of": [
                {
                  "test": "has_biome_tag",
                  "value": "cold"
                },
                {
                  "test": "has_biome_tag",
                  "value": "frozen"
                }
              ]
            },
            "trigger": "minere:set_brown_variant"
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "has_biome_tag",
                  "value": "taiga"
                }
              ],
              "none_of": [
                {
                  "test": "has_biome_tag",
                  "value": "cold"
                },
                {
                  "test": "has_biome_tag",
                  "value": "frozen"
                },
                {
                  "test": "has_biome_tag",
                  "value": "roofed"
                }
              ]
            },
            "trigger": "minere:set_red_variant"
          },
          {
            "filters": {
              "none_of": [
                {
                  "test": "has_biome_tag",
                  "value": "cold"
                },
                {
                  "test": "has_biome_tag",
                  "value": "frozen"
                },
                {
                  "test": "has_biome_tag",
                  "value": "roofed"
                },
                {
                  "test": "has_biome_tag",
                  "value": "taiga"
                }
              ]
            },
            "trigger": "minere:set_light_variant"
          }
        ]
      },
      "minere:set_brown_variant": {
        "remove": {
          "component_groups": [
            "minere:deer_light",
            "minere:deer_red",
            "minere:deer_white"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_brown"
          ]
        }
      },
      "minere:set_light_variant": {
        "remove": {
          "component_groups": [
            "minere:deer_brown",
            "minere:deer_red",
            "minere:deer_white"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_light"
          ]
        }
      },
      "minere:set_red_variant": {
        "remove": {
          "component_groups": [
            "minere:deer_brown",
            "minere:deer_light",
            "minere:deer_white"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_red"
          ]
        }
      },
      "minere:set_white_variant": {
        "remove": {
          "component_groups": [
            "minere:deer_brown",
            "minere:deer_light",
            "minere:deer_red"
          ]
        },
        "add": {
          "component_groups": [
            "minere:deer_white"
          ]
        }
      }
    }
  }
}