              "test": "has_component",
              "value": "minecraft:is_tamed"
            },
            "add": {
              "component_groups": ["minere:adult_tame"]
            }
          },
          {
            "filters": {
              "test": "has_component",
              "subject": "self",
              "operator": "!=",
              "value": "minecraft:is_tamed"
            },
            "add": {
              "component_groups": ["minere:adult_wild"]
            }
          }
        ]
