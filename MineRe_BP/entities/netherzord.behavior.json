{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minere:netherzord",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "mode_switcher": {
        "minecraft:target_nearby_sensor": {
          "inside_range": 3.5,
          "outside_range": 4,
          "must_see": true,
          "on_inside_range": {
            "event": "switch_to_melee",
            "target": "self"
          },
          "on_outside_range": {
            "event": "switch_to_ranged",
            "target": "self"
          }
        }
      },
      "ranged_mode": {
        "minecraft:shooter": {
          "def": "minere:lizord_fireball"
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 3,
          "attack_radius": 32,
          "burst_shots": 3,
          "burst_interval": 0.4,
          "charge_shoot_trigger": 2.0,
          "charge_charged_trigger": 1
        }
      },
      "melee_mode": {
        "minecraft:behavior.delayed_attack": {
          "priority": 3,
          "attack_duration": 0.5,
          "attack_once": false,
          "cooldown_time": 1,
          "track_target": true,
          "require_complete_path": false,
          "random_stop_interval": 0,
          "reach_multiplier": 1.25,
          "speed_multiplier": 1.4,
          "hit_delay_pct": 0.5
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/netherzord.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 30 : 0"
      },
      "minecraft:health": {
        "value": 120,
        "max": 120
      },
      "minecraft:attack": {
        "damage": [9, 12]
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "entity_explosion",
            "damage_multiplier": 1.25
          },
          {
            "cause": "block_explosion",
            "damage_multiplier": 1.25
          },
          {
            "cause": "projectile",
            "damage_multiplier": 0.75
          }
        ]
      },
      "minecraft:type_family": {
        "family": ["netherzord", "mob", "monster"]
      },
      "minecraft:collision_box": {
        "width": 2.6,
        "height": 2.25
      },
      "minecraft:follow_range": {
        "value": 64,
        "max": 64
      },
      "minecraft:shooter": {
        "def": "minecraft:fireball"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "within_radius": 32,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "irongolem"
                }
              ]
            },
            "max_dist": 48
          }
        ],
        "must_see": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:fire_immune": {},
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "max_distance": 128,
          "min_distance": 64
        }
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["mode_switcher"]
        }
      },
      "switch_to_melee": {
        "remove": {
          "component_groups": ["ranged_mode"]
        },
        "add": {
          "component_groups": ["melee_mode"]
        }
      },
      "switch_to_ranged": {
        "remove": {
          "component_groups": ["melee_mode"]
        },
        "add": {
          "component_groups": ["ranged_mode"]
        }
      },
      "minecraft:on_hurt_event": {
        "add": {
          "component_groups": ["mode_switcher"]
        }
      }
    }
  }
}
