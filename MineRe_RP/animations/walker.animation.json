{
  "format_version": "1.8.0",
  "animations": {
    "animation.minere.walker.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "relative_to": {
            "rotation": "entity"
          },
          "rotation": [
            "query.target_x_rotation - this",
            "query.target_y_rotation - this",
            0
          ],
          "position": [
            0,
            "Math.clamp((-0.2 * query.target_x_rotation), -2, 1)",
            "Math.clamp((-0.25 * query.target_x_rotation), -4, 1)"
          ]
        },
        "left_flap": {
          "rotation": ["-1 * query.target_x_rotation", 0, 0]
        },
        "right_flap": {
          "rotation": ["-1 * query.target_x_rotation", 0, 0]
        }
      }
    },
    "animation.minere.walker.walk": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved * 0.1",
      "bones": {
        "left_leg": {
          "rotation": [
            "math.cos(query.anim_time * 150) *  12",
            0,
            "math.sin(30 + query.anim_time * 150) * -1"
          ],
          "position": [
            "Math.min(0, math.sin(query.anim_time * 150) *  -1)",
            "Math.max(-1, math.sin(query.anim_time * 150) *  5)",
            0
          ]
        },
        "right_leg": {
          "rotation": [
            "math.cos(query.anim_time * 150) *  -12",
            0,
            "math.sin(30 + query.anim_time * 150) * -1"
          ],
          "position": [
            "Math.max(0, math.cos(query.anim_time * 150) *  1)",
            "Math.max(-1, math.sin(query.anim_time * 150) *  -5)",
            0
          ]
        },
        "left_flap": {
          "rotation": [
            "10 + math.cos(query.anim_time * 150) * 6",
            0,
            "math.cos(5 + query.anim_time * 150) *  5"
          ]
        },
        "right_flap": {
          "rotation": [
            "10 + math.cos(query.anim_time * 150) * -6",
            0,
            "math.cos(5 + query.anim_time * 150) *  5"
          ]
        },
        "head": {
          "rotation": [0, 0, "math.cos(10 + query.anim_time * 150) *  -3"],
          "position": [
            "math.sin(query.anim_time * 150) *  1",
            "Math.max(-0.5, math.sin(-10 + query.anim_time * 300) *  1.0)",
            0
          ]
        },
        "body": {
          "rotation": [0, 0, "math.sin(25 + query.anim_time * 150) *  2"]
        }
      }
    },
    "animation.minere.walker.radar": {
      "loop": true,
      "bones": {
        "radarTop": {
          "rotation": [0, "query.anim_time * 100", 0]
        },
        "radarRight": {
          "rotation": ["query.anim_time * 100", 0, 0]
        },
        "radarLeft": {
          "rotation": ["query.anim_time * -100", 0, 0]
        }
      }
    },
    "animation.minere.walker.kick": {
      "animation_length": 1.5,
      "bones": {
        "left_leg": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.5": [15, 0, 0],
            "0.75": [-45, 0, 0],
            "1.5": [0, 0, 0]
          },
          "position": {
            "0.0": [0, 0, 0],
            "0.5": [0, 0, 2],
            "0.75": [0, 0, -5],
            "1.5": [0, 0, 0]
          }
        },
        "right_leg": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.5": [-5, 0, 0],
            "0.75": [15, 0, 0],
            "1.5": [0, 0, 0]
          },
          "position": {
            "0.0": [0, 0, 0],
            "0.5": [0, 0, 1],
            "0.75": [0, 0, -2],
            "1.5": [0, 0, 0]
          }
        },
        "head": {
          "position": {
            "0.0": [0, 0, 0],
            "0.5": [0, 0, 2],
            "0.75": [0, 0, -4],
            "1.5": [0, 0, 0]
          }
        }
      },
      "sound_effects": {
        "0.5": {
          "effect": "kick"
        }
      }
    },
    "animation.minere.walker.emerge": {
      "loop": false,
      "animation_length": 3.5,
      "bones": {
        "body": {
          "position": {
            "0.0": [0, -95, 0],
            "3.0": [0, 0, 0]
          }
        }
      },
      "sound_effects": {
        "0.5": {
          "effect": "emerge"
        }
      },
      "particle_effects": {
        "0.25": {
          "effect": "emerge",
          "pre_effect_script": "variable.dig_particle_texture_coordinate = query.surface_particle_texture_coordinate; variable.dig_particle_texture_size = query.surface_particle_texture_size; variable.dig_particle_color = query.surface_particle_color;"
        }
      }
    },
    "animation.minere.walker.flaps": {
      "loop": true,
      "bones": {
        "left_flap": {
          "rotation": ["math.cos(query.anim_time * 55) * 4", 0, 0]
        },
        "right_flap": {
          "rotation": ["math.cos(25 + query.anim_time * 65) * -4", 0, 0]
        }
      }
    },
    "animation.minere.walker.shoot": {
      "loop": true,
      "bones": {
        "head_shooting": {
          "scale": 1
        },
        "head_watching": {
          "scale": 0
        },
        "head_blinking": {
          "scale": 0
        }
      }
    },
    "animation.minere.walker.watch": {
      "loop": true,
      "bones": {
        "head_shooting": {
          "scale": 0
        },
        "head_watching": {
          "scale": 1
        },
        "head_blinking": {
          "scale": 0
        }
      }
    },
    "animation.minere.walker.blink": {
      "loop": true,
      "bones": {
        "head_shooting": {
          "scale": 0
        },
        "head_watching": {
          "scale": 0
        },
        "head_blinking": {
          "scale": 1
        }
      }
    }
  }
}
