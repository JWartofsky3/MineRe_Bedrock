{
  "format_version": "1.8.0",
  "animations": {
    "animation.minere.gremlin.look_at_target": {
      "loop": true,
      "bones": {
        "body": {
          "relative_to": {
            "rotation": "entity"
          },
          "rotation": [
            "query.target_x_rotation/2",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.minere.gremlin.walk": {
      "loop": true,
      "bones": {
        "right_leg": {
          "rotation": ["35 * Math.cos(query.anim_time * 500)", 0, 0]
        },
        "left_leg": {
          "rotation": ["-35 * Math.cos(query.anim_time * 500)", 0, 0]
        },
        "left_arm": {
          "rotation": ["25 * Math.cos(query.anim_time * 500)", 0, 0]
        },
        "right_arm": {
          "rotation": ["-25 * Math.cos(query.anim_time * 500)", 0, 0]
        },
        "body": {
          "rotation": [0, 0, "-2 * Math.cos(15 + query.anim_time * 500)"]
        }
      }
    },
    "animation.minere.gremlin.idle": {
      "loop": true,
      "animation_length": 1.25,
      "bones": {
        "left_arm": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.5": [0, 0, -7.5],
            "1.0": [0, 0, 0]
          }
        },
        "right_arm": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.5": [0, 0, 7.5],
            "1.0": [0, 0, 0]
          }
        }
      }
    },
    "animation.minere.gremlin.attack": {
      "animation_length": 0.5,
      "bones": {
        "left_arm": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.0833": [-125, 0, 0],
            "0.5": [0, 0, 0]
          }
        },
        "right_arm": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.0833": [-125, 0, 0],
            "0.5": [0, 0, 0]
          }
        }
      }
    },
    "animation.minere.gremlin.panic": {
      "loop": true,
      "bones": {
        "left_arm": {
          "rotation": ["-180 + Math.cos(query.anim_time * 250) * -45", 0, 0]
        },
        "right_arm": {
          "rotation": ["-180 + Math.cos(query.anim_time * 200) * 45", 0, 0]
        }
      }
    }
  }
}
