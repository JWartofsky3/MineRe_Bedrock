{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.minere.monkey": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.orange",
            "Texture.brown",
            "Texture.red",
            "Texture.black",
            "Texture.gray",
            "Texture.green",
            "Texture.white",
            "Texture.blue",
            "Texture.crimson",
            "Texture.purple",
            "Texture.teal",
            "Texture.pink"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.variant]"
      ]
    },
    "controller.render.minere.monkey_face": {
      "arrays": {
        "textures": {
          "Array.faces": [
            "Texture.empty",
            "Texture.face_playful",
            "Texture.face_aggressive",
            "Texture.face_fearful",
            "Texture.face_lazy",
            "Texture.face_friendly"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.faces[query.mark_variant]"
      ]
    },
    "controller.render.minere.monkey_collar": {
      "arrays": {
        "textures": {
          "Array.collar": [
            "Texture.empty",
            "Texture.collar_white",
            "Texture.collar_orange",
            "Texture.collar_magenta",
            "Texture.collar_light_blue",
            "Texture.collar_yellow",
            "Texture.collar_lime",
            "Texture.collar_pink",
            "Texture.collar_gray",
            "Texture.collar_light_gray",
            "Texture.collar_cyan",
            "Texture.collar_purple",
            "Texture.collar_blue",
            "Texture.collar_brown",
            "Texture.collar_green",
            "Texture.collar_red",
            "Texture.collar_black"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.collar[query.is_tamed ? (query.property('minere:collar_color') + 1) : 0]"
      ]
    },
    "controller.render.minere.monkey_bite": {
      "arrays": {
        "textures": {
          "Array.bites": [
            "Texture.empty",
            "Texture.bite0",
            "Texture.bite1"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.bites[variable.is_biting ? (variable.bite_frame + 1) : 0]"
      ]
    }
  }
}
