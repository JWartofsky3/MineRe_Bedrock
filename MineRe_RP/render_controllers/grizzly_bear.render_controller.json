{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.minere.grizzly_bear": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.brown",
            "Texture.light",
            "Texture.gray",
            "Texture.red",
            "Texture.blue"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.variant]"
      ]
    },
    "controller.render.minere.grizzly_bear_chest": {
      "arrays": {
        "textures": {
          "Array.chest": [
            "Texture.empty",
            "Texture.chest"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.chest[query.is_chested ? 1 : 0]"
      ]
    },
    "controller.render.minere.grizzly_bear_armor": {
      "arrays": {
        "textures": {
          "Array.armor": [
            "Texture.empty",
            "Texture.copper_armor",
            "Texture.iron_armor",
            "Texture.gold_armor",
            "Texture.diamond_armor",
            "Texture.netherite_armor",
            "Texture.enderon_armor",
            "Texture.indigon_armor"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.armor[variable.armor]"
      ]
    },
    "controller.render.minere.grizzly_bear_saddle": {
      "arrays": {
        "textures": {
          "Array.saddle": [
            "Texture.empty",
            "Texture.saddle"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.saddle[query.is_saddled ? 1 : 0]"
      ]
    }
  }
}
