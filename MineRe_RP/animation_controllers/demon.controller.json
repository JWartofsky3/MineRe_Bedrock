{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.demon": {
      "initial_state": "walking",
      "states": {
        "walking": {
          "animations": [
            "breathe",
            {
              "walk": "query.modified_move_speed"
            },
            "look_at_target"
          ],
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking == 1"
            },
            {
              "casting": "query.is_roaring == 1 || query.is_casting"
            }
          ],
          "blend_transition": 0.2
        },
        "attacking": {
          "animations": [
            "attack",
            "look_at_target",
            {
              "walk": "query.modified_move_speed"
            },
            "breathe"
          ],
          "transitions": [
            {
              "walking": "query.all_animations_finished"
            },
            {
              "casting": "query.is_roaring == 1 || query.is_casting"
            }
          ],
          "blend_transition": 0.2
        },
        "casting": {
          "animations": ["roar"],
          "transitions": [
            {
              "walking": "query.is_roaring == 0 && !query.is_casting"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}
