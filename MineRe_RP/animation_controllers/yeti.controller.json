{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.yeti": {
      "initial_state": "walking",
      "states": {
        "walking": {
          "animations": [
            "breathe",
            "look_at_target",
            {
              "walk": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking == 1"
            },
            {
              "climbing": "query.is_wall_climbing == 1"
            },
            {
              "berserking": "query.ground_speed > 6.0"
            },
            {
              "sitting": "query.is_sitting"
            }
          ],
          "blend_transition": 0.5
        },
        "berserking": {
          "animations": [
            {
              "berserk": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking == 1"
            },
            {
              "walking": "query.ground_speed <= 5.0 && query.all_animations_finished"
            },
            {
              "climbing": "query.is_wall_climbing == 1"
            },
            {
              "sitting": "query.is_sitting"
            }
          ],
          "blend_transition": 0.5
        },
        "climbing": {
          "animations": ["climb", "look_at_target"],
          "transitions": [
            {
              "walking": "query.is_wall_climbing == 0"
            },
            {
              "sitting": "query.is_sitting"
            }
          ],
          "blend_transition": 0.5
        },
        "attacking": {
          "animations": [
            "attack",
            "look_at_target",
            {
              "walk": "query.modified_move_speed * 0.7"
            }
          ],
          "transitions": [
            {
              "walking": "query.all_animations_finished && !query.is_wall_climbing"
            },
            {
              "climbing": "query.all_animations_finished && query.is_wall_climbing"
            }
          ],
          "blend_transition": 0.5
        },
        "sitting": {
          "animations": ["sit", "look_at_target", "breathe"],
          "transitions": [
            {
              "walking": "!query.is_sitting"
            }
          ],
          "blend_transition": 0.75
        }
      }
    },
    "controller.animation.minere.yeti.face": {
      "initial_state": "neutral",
      "states": {
        "neutral": {
          "animations": ["neutral"],
          "transitions": [
            {
              "angry": "query.is_angry && query.has_target"
            },
            {
              "tame": "query.is_tamed"
            },
            {
              "scared": "query.is_avoiding_mobs || query.is_avoiding_block"
            }
          ]
        },
        "tame": {
          "animations": ["tame"],
          "transitions": [
            {
              "neutral": "!query.is_tamed"
            }
          ]
        },
        "angry": {
          "animations": ["angry"],
          "transitions": [
            {
              "neutral": "!query.is_angry || !query.has_target"
            },
            {
              "tame": "query.is_tamed"
            },
            {
              "scared": "query.is_avoiding_mobs || query.is_avoiding_block"
            }
          ]
        },
        "scared": {
          "animations": ["scared"],
          "transitions": [
            {
              "tame": "query.is_tamed"
            },
            {
              "neutral": "!(query.is_avoiding_mobs || query.is_avoiding_block)"
            }
          ]
        }
      }
    }
  }
}
