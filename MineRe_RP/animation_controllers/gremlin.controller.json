{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.gremlin": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            {
              "walking": "query.ground_speed > 0.5"
            }
          ],
          "blend_transition": 0.2
        },
        "walking": {
          "animations": [
            {
              "walk": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "idle": "query.ground_speed < 0.4"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.gremlin_attack": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "attacking": "variable.attack_time > 0.0"
            },
            {
              "panicing": "(query.is_scared || query.is_avoiding_mobs || query.is_avoiding_block) && query.ground_speed > 0.6"
            }
          ],
          "blend_transition": 0.1
        },
        "attacking": {
          "animations": ["attack"],
          "transitions": [
            {
              "idle": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.1
        },
        "panicing": {
          "animations": ["panic"],
          "transitions": [
            {
              "idle": "!(query.is_scared || query.is_avoiding_mobs || query.is_avoiding_block) || query.ground_speed < 0.5"
            }
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}
