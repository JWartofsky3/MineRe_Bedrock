{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.monkey": {
      "initial_state": "walking",
      "states": {
        "walking": {
          "animations": [
            {
              "walk": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "running": "query.ground_speed > 3.0"
            },
            {
              "climbing": "query.is_wall_climbing == 1"
            },
            {
              "sitting": "query.is_sitting && query.ground_speed < 0.5"
            }
          ],
          "blend_transition": 0.2
        },
        "running": {
          "animations": [
            {
              "run": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "walking": "query.ground_speed <= 3.0"
            },
            {
              "climbing": "query.is_wall_climbing == 1"
            },
            {
              "sitting": "query.is_sitting && query.ground_speed < 0.5"
            }
          ],
          "blend_transition": 0.2
        },
        "climbing": {
          "animations": ["climb"],
          "transitions": [
            {
              "walking": "query.is_wall_climbing == 0"
            },
            {
              "sitting": "query.is_sitting"
            }
          ],
          "blend_transition": 0.2
        },
        "sitting": {
          "animations": ["sit"],
          "transitions": [
            {
              "walking": "!query.is_sitting || query.ground_speed > 0.5"
            },
                        {
              "running": "!query.is_sitting || query.ground_speed > 3.0"
            },
            {
              "climbing": "!query.is_sitting || query.is_wall_climbing == 1"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
    "controller.animation.minere.monkey_attack": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["jaw_closed"],
          "transitions": [
            {
              "attacking": "variable.attack_time > 0.0"
            }
          ],
          "blend_transition": 0.2
        },
        "attacking": {
          "animations": ["attack"],
          "transitions": [
            {
              "idle": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}
