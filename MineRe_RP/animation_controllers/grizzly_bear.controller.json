{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.grizzly_bear": {
      "initial_state": "walking",
      "states": {
        "walking": {
          "animations": [
            {
              "walk": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking"
            },
            {
              "running": "query.ground_speed > 4.5 && query.all_animations_finished"
            },
            {
              "sitting": "query.ground_speed < 1.0 && query.is_sitting && !query.has_target"
            }
          ],
          "blend_transition": 0.2
        },
        "running": {
          "animations": [
            {
              "run": "query.modified_move_speed"
            }
          ],
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking"
            },
            {
              "walking": "query.ground_speed <= 3.5 && query.all_animations_finished"
            }
          ],
          "blend_transition": 0.2
        },
        "attacking": {
          "animations": ["attack"],
          "transitions": [
            {
              "walking": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.2
        },
        "sitting": {
          "animations": ["sit"],
          "transitions": [
            {
              "walking": "query.ground_speed > 1.0 || !query.is_sitting"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}
