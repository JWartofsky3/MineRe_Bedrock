{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.glacier_submerge": {
      "initial_state": "emerging",
      "states": {
        "emerging": {
          "animations": ["emerge"],
          "transitions": [
            {
              "default": "query.all_animations_finished || !query.property('minere:is_emerging')"
            }
          ],
          "blend_transition": 0.2
        },
        "default": {
          "transitions": [
            {
              "emerging": "query.property('minere:is_emerging')"
            },
            {
              "submerging": "query.property('minere:is_submerging')"
            }
          ],
          "blend_transition": 0.2
        },
        "submerging": {
          "animations": ["submerge"],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.glacier_ice_charges": {
      "initial_state": "gone",
      "states": {
        "gone": {
          "animations": ["iceChargesGone"],
          "transitions": [
            {
              "summon": "query.is_charged && !variable.is_transitioning"
            }
          ],
          "blend_transition": 0.2
        },
        "summon": {
          "animations": ["iceChargesSummon"],
          "transitions": [
            {
              "shoot": "!query.is_charged"
            },
            {
              "gone": "variable.is_transitioning"
            }
          ],
          "blend_transition": 0.2
        },
        "shoot": {
          "animations": ["iceChargesShoot"],
          "transitions": [
            {
              "gone": "query.all_animations_finished || variable.is_transitioning"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.glacier": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "summoning": "query.is_casting"
            },
            {
              "roaring": "query.is_roaring"
            },
            {
              "angry": "query.is_angry"
            }
          ],
          "blend_transition": 0.2
        },
        "angry": {
          "animations": ["angry"],
          "transitions": [
            {
              "summoning": "query.is_casting"
            },
            {
              "roaring": "query.is_roaring"
            },
            {
              "default": "!query.is_angry"
            }
          ],
          "blend_transition": 0.2
        },
        "summoning": {
          "animations": ["summon"],
          "transitions": [
            {
              "angry": "!query.is_casting"
            }
          ],
          "blend_transition": 0.2
        },
        "roaring": {
          "animations": ["roar"],
          "transitions": [
            {
              "angry": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.glacier_face": {
      "initial_state": "neutral",
      "states": {
        "neutral": {
          "animations": ["neutral_face"],
          "transitions": [
            {
              "roaring": "query.is_roaring"
            },
            {
              "angry": "query.is_angry"
            },
                        {
              "attacking": "query.is_delayed_attacking"
            }
          ]
        },
        "angry": {
          "animations": ["angry_face"],
          "transitions": [
            {
              "roaring": "query.is_roaring"
            },
            {
              "neutral": "!query.is_angry"
            },
            {
              "attacking": "query.is_delayed_attacking"
            }
          ]
        },
        "roaring": {
          "animations": ["roaring_face"],
          "transitions": [
            {
              "angry": "query.all_animations_finished && query.is_angry"
            },
            {
              "neutral": "query.all_animations_finished && !query.is_angry"
            }
          ]
        },
        "attacking": {
          "animations": ["attacking_face"],
          "transitions": [
              {
              "roaring": "query.is_roaring"
            },
            {
              "angry": "!query.is_delayed_attacking"
            }
          ]
        }
      }
    }
  }
}
