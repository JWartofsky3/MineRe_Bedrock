{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.glacier_submerge": {
            "initial_state": "emerging",
      "states": {
        "emerging": {
          "animations": ["emerge"],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        },
                "default": {
          "transitions": [
            {
              "submerging": "query.property('minere:is_submerging')"
            }
          ]
        },
        "submerging": {
          "animations": ["submerge"],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.minere.glacier_ice_charges": {
      "initial_state": "gone",
      "states": {
        "gone": {
          "animations": ["iceChargesGone"],
          "transitions": [
            {
              "summon": "query.is_charged"
            }
          ]
        },
        "summon": {
          "animations": ["iceChargesSummon"],
          "transitions": [
            {
              "shoot": "!query.is_charged"
            }
          ]
        },
        "shoot": {
          "animations": ["iceChargesShoot"],
          "transitions": [
            {
              "gone": "query.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.minere.glacier": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "summoning": "query.is_casting"
            },
            {
              "roaring": "query.is_roaring"
            },
            {
              "angry": "query.is_angry"
            }
          ]
        },
        "angry": {
          "animations": ["angry"],
          "transitions": [
            {
              "summoning": "query.is_casting"
            },
            {
              "roaring": "query.is_roaring"
            },
            {
              "default": "!query.is_angry"
            }
          ]
        },
        "summoning": {
          "animations": ["summon"],
          "transitions": [
            {
              "angry": "!query.is_casting"
            }
          ]
        },
        "roaring": {
          "animations": ["roar"],
          "transitions": [
            {
              "angry": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
