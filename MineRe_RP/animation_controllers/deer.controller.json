{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.deer": {
      "initial_state": "walking",
      "states": {
        "walking": {
          "animations": [
            {
              "walk": "query.modified_move_speed"
            },
            "look_at_target",
            "tail"
          ],
          "transitions": [
            {
              "running": "query.ground_speed > 4"
            },
            {
              "grazing": "query.is_grazing"
            }
          ],
          "blend_transition": 0.5
        },
        "running": {
          "animations": [
            {
              "gallop": "query.modified_move_speed"
            },
            "look_at_target"
          ],
          "transitions": [
            {
              "walking": "query.ground_speed <= 4"
            }
          ],
          "blend_transition": 0.5
        },
        "grazing": {
          "animations": [
            {
              "walk": "query.modified_move_speed"
            },
            "graze",
            "tail"
          ],
          "transitions": [
            {
              "running": "query.ground_speed > 4"
            },
            {
              "walking": "!query.is_grazing"
            }
          ]
        }
      }
    }
  }
}
