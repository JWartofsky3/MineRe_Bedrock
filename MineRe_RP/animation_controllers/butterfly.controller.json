{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.butterfly": {
      "initial_state": "flying",
      "states": {
        "flying": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "landed": "query.is_on_ground"
            }
          ],
          "blend_transition": 0.4
        },
        "landed": {
          "animations": [
            "land"
          ],
          "transitions": [
            {
              "flying": "!query.is_on_ground"
            }
          ],
          "blend_transition": 0.4
        }
      }
    }
  }
}