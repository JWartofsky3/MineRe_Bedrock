{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minere.rat.attack": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [{ "attacking": "variable.attack_time > 0.0" }]
        },
        "attacking": {
          "animations": ["attack"],
          "transitions": [{ "idle": "query.all_animations_finished" }]
        }
      }
    }
  }
}
