{
  "format_version": "1.10",
  "animation_controllers": {
    "controller.animation.minere.inferno_phase": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["angle"],
          "transitions": [
            { "melee": "query.property('minere:phase') == 1" },
            { "no_angle": "query.property('minere:phase') == 2" },
            { "stomp": "query.property('minere:phase') == 3" },
            { "guard": "query.property('minere:phase') == 4" },
            { "stunned": "query.property('minere:phase') == 5" }
          ],
          "blend_transition": 0.2
        },
        "no_angle": {
          "transitions": [
            { "default": "query.property('minere:phase') == 0" },
            { "melee": "query.property('minere:phase') == 1" },
            { "stomp": "query.property('minere:phase') == 3" },
            { "stunned": "query.property('minere:phase') == 5" }
          ],
          "blend_transition": 0.2
        },
        "guard": {
          "animations": ["guard"],
          "transitions": [
            { "default": "query.property('minere:phase') == 0" },
            { "melee": "query.property('minere:phase') == 1" },
            { "no_angle": "query.property('minere:phase') == 2" },
            { "stomp": "query.property('minere:phase') == 3" },
            { "stunned": "query.property('minere:phase') == 5" }
          ],
          "blend_transition": 0.2
        },
        "melee": {
          "animations": ["melee", "swing"],
          "transitions": [
            { "default": "query.property('minere:phase') == 0" },
            { "no_angle": "query.property('minere:phase') == 2" },
            { "stomp": "query.property('minere:phase') == 3" },
            { "guard": "query.property('minere:phase') == 4" },
            { "stunned": "query.property('minere:phase') == 5" }
          ],
          "blend_transition": 0.2
        },
        "stomp": {
          "animations": ["stomp"],
          "transitions": [
            { "default": "query.property('minere:phase') == 0" },
            { "melee": "query.property('minere:phase') == 1" },
            { "no_angle": "query.property('minere:phase') == 2" },
            { "guard": "query.property('minere:phase') == 4" },
            { "stunned": "query.property('minere:phase') == 5" }
          ],
          "blend_transition": 0.2
        },
        "stunned": {
          "animations": ["weak"],
          "transitions": [
            { "default": "query.property('minere:phase') == 0" },
            { "melee": "query.property('minere:phase') == 1" },
            { "no_angle": "query.property('minere:phase') == 2" },
            { "stomp": "query.property('minere:phase') == 3" },
            { "guard": "query.property('minere:phase') == 4" }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.inferno_action": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            { "push": "query.is_roaring" },
            { "cast": "query.is_casting" }
          ],
          "blend_transition": 0.2
        },
        "push": {
          "animations": ["push"],
          "transitions": [{ "idle": "query.all_animations_finished" }],
          "blend_transition": 0.2
        },
        "cast": {
          "animations": ["summon"],
          "transitions": [{ "idle": "query.all_animations_finished" }],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.inferno_look": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["look"],
          "transitions": [{ "stunned": "query.property('minere:phase') == 5" }],
          "blend_transition": 0.2
        },
        "stunned": {
          "transitions": [{ "default": "query.property('minere:phase') != 5" }],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.minere.inferno_spin": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["spin", "bounce"],
          "transitions": [
            { "melee": "query.property('minere:phase') == 1" },
            { "stomp": "query.property('minere:phase') == 3" },
            { "stunned": "query.property('minere:phase') == 5" }
          ]
        },
        "melee": {
          "animations": [
            {
              "spin": "8.0"
            },
            "bounce"
          ],
          "transitions": [{ "default": "query.property('minere:phase') != 1" }]
        },
        "stomp": {
          "animations": [
            {
              "spin": "3.0"
            },
            "bounce"
          ],
          "transitions": [{ "default": "query.property('minere:phase') != 3" }]
        },
        "stunned": {
          "animations": [
            {
              "bounce": "0.25"
            }
          ],
          "transitions": [{ "default": "query.property('minere:phase') != 5" }]
        }
      }
    }
  }
}
