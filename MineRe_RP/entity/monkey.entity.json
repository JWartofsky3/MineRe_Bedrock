        "attack_controller": "controller.animation.minere.monkey_attack"
      },
      "sound_effects": {
        "eat": "mob.monkey.eat",
        "burp": "random.burp"
      },
      "particle_effects": {
        "eat_crumbs": "minere:monkey_eat_crumbs"
      },
      "scripts": {
        "pre_animation": [
          "variable.play_anim = !variable.attack_time && (query.is_sitting || (query.ground_speed < 0.5 && query.is_on_ground));",
          "variable.bite_frame = math.mod(query.life_time * 4, 2);",
          "variable.is_biting = variable.attack_time > 0.0 || variable.play_anim && (query.property('minere:anim_state') == 3 || query.property('minere:anim_state') == 8);",
          "variable.is_sleeping = variable.play_anim && query.property('minere:anim_state') == 9;"
        ],
        "animate": [
          "controller",
          "attack_controller",
          "sit_controller",
          {
            "is_baby": "query.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.minere.monkey_sleep",
        "controller.render.minere.monkey_bite",
        "controller.render.minere.monkey_face",
        "controller.render.minere.monkey_collar",
        "controller.render.minere.monkey"
      ],
      "enable_attachables": true,
      "spawn_egg": {
        "base_color": "#866141",
        "overlay_color": "#995418"
      }
    }
  }
