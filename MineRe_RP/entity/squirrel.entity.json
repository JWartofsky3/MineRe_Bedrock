{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minere:squirrel",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "red": "textures/entity/minere/squirrel/red",
        "gray": "textures/entity/minere/squirrel/gray",
        "black": "textures/entity/minere/squirrel/black"
      },
      "geometry": {
        "default": "geometry.minere.squirrel"
      },
      "animations": {
        "move": "animation.minere.squirrel.move",
        "sit": "animation.minere.squirrel.sit",
        "look_at": "animation.minere.squirrel.look_at",
        "baby_transform": "animation.minere.squirrel.baby_transform",
        "controller": "controller.animation.minere.squirrel"
      },
      "scripts": {
        "scale": "0.9",
        "pre_animation": [
          "variable.should_sit = math.mod(query.life_time, 32) >= 12;"
        ],
        "animate": [
          "look_at",
          "controller",
          {
            "baby_transform": "query.is_baby"
          }
        ]
      },
      "render_controllers": ["controller.render.minere.squirrel"],
      "spawn_egg": {
        "base_color": "#b8653f",
        "overlay_color": "#894b39"
      }
    }
  }
}
