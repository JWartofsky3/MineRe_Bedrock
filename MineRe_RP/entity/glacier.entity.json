{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minere:glacier",
      "materials": {
        "default": "entity_emissive_alpha",
        "emissive": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/minere/glacier/glacier",
        "iceCharges0": "textures/entity/minere/glacier/ice_charges0",
