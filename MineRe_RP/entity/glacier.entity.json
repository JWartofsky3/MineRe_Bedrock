        "breathe1": "textures/entity/minere/glacier/breathe1",
        "breathe2": "textures/entity/minere/glacier/breathe2",
        "empty": "textures/entity/minere/freeze/empty"
      },
      "geometry": {
        "default": "geometry.minere.glacier",
        "iceCharges": "geometry.minere.glacier_ice_charges",
        "breathe": "geometry.minere.glacier_breath"
      },
      "animations": {
        "iceChargesGone": "animation.minere.glacier.iceChargesGone",
        "iceChargesSummon": "animation.minere.glacier.iceChargesSummon",
        "iceChargesSpin": "animation.minere.glacier.iceChargesSpin",
        "iceChargesShoot": "animation.minere.glacier.iceChargesShoot",
        "freezeAttackController": "controller.animation.minere.freeze_attack",
        "roar": "animation.minere.glacier.roar",
        "roaring_face": "animation.minere.glacier.roaring_face",
        "emerge": "animation.minere.glacier.emerge",
        "submerge": "animation.minere.glacier.submerge",
        "summon": "animation.minere.glacier.summon",
        "angry": "animation.minere.glacier.angry",
        "angry_face": "animation.minere.glacier.angry_face",
        "neutral_face": "animation.minere.glacier.neutral_face",
        "attacking_face": "animation.minere.glacier.attacking_face",
        "controller": "controller.animation.minere.glacier",
        "iceChargesController": "controller.animation.minere.glacier_ice_charges",
        "submergeController": "controller.animation.minere.glacier_submerge",
        "faceController": "controller.animation.minere.glacier_face"
      },
      "particle_effects": {
        "freeze_breath": "minere:freeze_breath",
        "emerge": "minecraft:warden_dig",
        "blueFlame": "minere:glacier_ice_charge_skull_particles",
        "snow": "minere:glacier_ice_charge_particles"
      },
      "scripts": {
        "pre_animation": [
          "variable.is_attacking = query.is_delayed_attacking ? 1 : 0;",
          "variable.textureframe = math.mod(query.life_time * 7, 3);",
          "variable.is_transitioning = query.property('minere:is_submerging') || query.property('minere:is_emerging');"
        ],
        "animate": [
          "iceChargesSpin",
          "freezeAttackController",
          "controller",
          "iceChargesController",
          "submergeController",
          "faceController"
        ]
      },
      "sound_effects": {
        "emerge": "mob.walker.emerge",
        "inhale": "boss.glacier.inhale",
        "blast": "item.ice_charge.blast"
      },
      "render_controllers": [
        "controller.render.minere.glacier",
        "controller.render.minere.glacier_breath",
        "controller.render.minere.glacier_ice_charges"
      ],
      "spawn_egg": {
        "base_color": "#3d2857",
        "overlay_color": "#cd0000"
      }
    }
