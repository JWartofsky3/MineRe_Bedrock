{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minere:goblin",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/minere/goblin/goblin",
        "blue": "textures/entity/minere/goblin/goblin_blue",
        "trader": "textures/entity/minere/goblin/goblin_trader"
      },
      "geometry": {
        "default": "geometry.minere.goblin"
      },
      "spawn_egg": {
        "base_color": "#33cc33",
        "overlay_color": "#3399ff"
      },
      "scripts": {
        "scale": "0.75",
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.attack = Math.sin((1.0 - (1.0 - variable.attack_time) * (1.0 - variable.attack_time)) * 180.0) * 57.3;",
          "variable.attack2 = Math.sin(variable.attack_time * 180.0) * 57.3;",
          "variable.z_bob = Math.cos(query.life_time * 103.13244) * 2.865 + 2.865;",
          "variable.x_bob = Math.sin(query.life_time * 76.776372) * 2.865;"
        ],
        "initialize": [
          "v.tp_melee_spear_base_arm_rotation_x = -30.0;"
        ],
        "variables": {
          "variable.item_use_normalized": "public",
          "variable.tp_melee_spear_use_attachable_rotation_z": "public"
        },
        "animate": [
          {
            "admire": "query.is_admiring"
          },
          {
            "humanoid_big_head": "query.is_baby"
          },
          {
            "celebrate_hunt": "query.is_celebrating"
          },
          {
            "celebrate_hunt_special": "query.is_celebrating_special"
          },
          "move",
          "bob",
          "look_at_target_controller",
          {
            "goblin_attack_controller": "!query.is_item_name_any('slot.weapon.mainhand', 'minecraft:wooden_spear', 'minecraft:stone_spear', 'minecraft:copper_spear', 'minecraft:iron_spear', 'minecraft:golden_spear', 'minecraft:diamond_spear', 'minecraft:netherite_spear')"
          },
          "riding_controller",
          "brandish_spear_controller",
          "charging_controller",
          {
            "melee_spear_controller": "query.is_item_name_any('slot.weapon.mainhand', 'minecraft:wooden_spear', 'minecraft:stone_spear', 'minecraft:copper_spear', 'minecraft:iron_spear', 'minecraft:golden_spear', 'minecraft:diamond_spear', 'minecraft:netherite_spear')"
          }
        ]
      },
      "animations": {
        "move": "animation.minere.goblin.move",
        "bob": "animation.humanoid.bob",
        "humanoid_big_head": "animation.humanoid.big_head",
        "admire": "animation.minere.goblin.admire",
        "celebrate_hunt": "animation.minere.goblin.celebrate_hunt",
        "celebrate_hunt_special": "animation.minere.goblin.celebrate_hunt_special",
        "look_at_target_controller": "controller.animation.humanoid.look_at_target",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "goblin_attack_controller": "controller.animation.minere.goblin.attack",
        "bow_and_arrow": "animation.humanoid.bow_and_arrow",
        "crossbow_hold": "animation.minere.goblin.crossbow.hold",
        "crossbow_charge": "animation.minere.goblin.crossbow.charge",
        "melee_attack": "animation.minere.goblin.sword.attack",
        "hand_attack": "animation.minere.goblin.hand.attack",
        "riding_controller": "controller.animation.humanoid.riding",
        "riding.arms": "animation.humanoid.riding.arms",
        "riding.legs": "animation.humanoid.riding.legs",
        "riding.body": "animation.humanoid.riding.body",
        "brandish_spear": "animation.humanoid.brandish_spear",
        "brandish_spear_controller": "controller.animation.humanoid.brandish_spear",
        "charging": "animation.humanoid.charging",
        "charging_controller": "controller.animation.humanoid.charging",
        "melee_spear_use": "animation.zombie.melee_spear_use",
        "melee_spear_hold": "animation.zombie.melee_spear_hold",
        "melee_spear_controller": "controller.animation.humanoid.melee_spear"
      },
      "render_controllers": ["controller.render.minere.goblin"],
      "enable_attachables": true
    }
  }
}
