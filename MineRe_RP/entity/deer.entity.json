{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minere:deer",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "brown": "textures/entity/minere/deer/brown",
        "light": "textures/entity/minere/deer/light",
        "red": "textures/entity/minere/deer/red",
        "white": "textures/entity/minere/deer/white",
        "saddle": "textures/entity/minere/deer/saddle",
        "reins": "textures/entity/minere/deer/reins",
        "empty": "textures/entity/minere/elephant/empty"
      },
      "geometry": {
        "default": "geometry.minere.deer"
      },
      "spawn_egg": {
        "base_color": "#ba9a80",
        "overlay_color": "#c0bab1"
      },
      "scripts": {
        "animate": [
          "controller",
          {
            "baby_transform": "query.is_baby"
          },
          {
            "hide_reins": "!query.is_saddled || !query.has_rider"
          }
        ]
      },
      "animations": {
        "walk": "animation.minere.deer.walk",
        "gallop": "animation.minere.deer.gallop",
        "look_at_target": "animation.minere.deer.look_at_target",
        "tail": "animation.minere.deer.tail",
        "graze": "animation.minere.deer.graze",
        "baby_transform": "animation.minere.deer.baby_transform",
        "hide_reins": "animation.minere.deer.hide_reins",
        "controller": "controller.animation.minere.deer"
      },
      "render_controllers": [
        "controller.render.minere.deer_saddle",
        "controller.render.minere.deer_reins",
        "controller.render.minere.deer"
      ]
    }
  }
}
